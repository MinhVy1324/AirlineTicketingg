# Copy this file to .env and replace the placeholder before starting Compose.
POSTGRES_DB=airline_ticketing
POSTGRES_USER=airline_app
POSTGRES_PASSWORD=replace-with-a-unique-random-secret
POSTGRES_PORT=5432

# IP theo khu vực (như CRM):
#   127.0.0.1 -> Admin      ("/" chuyển /admin)
#   127.0.0.2 -> Manager    ("/" chuyển /quan-ly)
#   127.0.0.3 -> Khách hàng
#   127.0.0.1:8080 -> Tất cả (ASPNETCORE_PORT)
# Nếu Windows + Docker Desktop không truy cập được 127.0.0.2/127.0.0.3: xem docs/INSTALL-WINDOWS.md (fallback bind 127.0.0.1 + port khác).
ASPNETCORE_PORT=8080
WEB_BIND_ADMIN=127.0.0.1
WEB_BIND_MANAGER=127.0.0.2
WEB_BIND_USER=127.0.0.3
WEB_PORT_ADMIN=80
WEB_PORT_MANAGER=80
WEB_PORT_USER=80

ASPNETCORE_ENVIRONMENT=Development
