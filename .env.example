# Copy this file to .env and replace the placeholder before starting Compose.
POSTGRES_DB=airline_ticketing
POSTGRES_USER=airline_app
POSTGRES_PASSWORD=replace-with-a-unique-random-secret
POSTGRES_PORT=5432

# Mỗi instance phục vụ cùng ứng dụng, khác khu vực. Mặc định bind 127.0.0.1 (Windows-friendly):
#   Admin      -> 127.0.0.1:WEB_PORT_ADMIN   (mặc định 8082, "/" chuyển /admin)
#   Manager    -> 127.0.0.1:WEB_PORT_MANAGER (mặc định 8083, "/" chuyển /quan-ly)
#   Khách hàng -> 127.0.0.1:WEB_PORT_USER    (mặc định 8081)
#   Tất cả     -> 127.0.0.1:ASPNETCORE_PORT  (mặc định 8080)
# Tùy chọn IP theo khu vực (Linux/macOS thường OK; Windows Docker Desktop có thể không hỗ trợ 127.0.0.2/127.0.0.3):
#   WEB_BIND_ADMIN=127.0.0.1  WEB_BIND_MANAGER=127.0.0.2  WEB_BIND_USER=127.0.0.3
# Ví dụ port 81=cus, 82=admin, 83=manager (tất cả trên 127.0.0.1): đặt WEB_PORT_USER=81, WEB_PORT_ADMIN=82, WEB_PORT_MANAGER=83
ASPNETCORE_PORT=8080
WEB_BIND_ADMIN=127.0.0.1
WEB_BIND_MANAGER=127.0.0.1
WEB_BIND_USER=127.0.0.1
WEB_PORT_ADMIN=8082
WEB_PORT_MANAGER=8083
WEB_PORT_USER=8081

ASPNETCORE_ENVIRONMENT=Development
