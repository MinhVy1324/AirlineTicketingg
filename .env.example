# Copy this file to .env and replace the placeholder before starting Compose.
POSTGRES_DB=airline_ticketing
POSTGRES_USER=airline_app
POSTGRES_PASSWORD=replace-with-a-unique-random-secret
POSTGRES_PORT=5432

# Mỗi instance phục vụ cùng ứng dụng, khác khu vực truy cập (mặc định dùng port 80 theo IP loopback):
#   127.0.0.1 -> Admin          (WEB_PORT_ADMIN, mặc định 80)  — "/" chuyển /admin
#   127.0.0.2 -> Manager        (WEB_PORT_MANAGER, mặc định 80) — "/" chuyển /quan-ly
#   127.0.0.3 -> Khách hàng     (WEB_PORT_USER, mặc định 80)
#   127.0.0.1:8080 -> Tất cả    (ASPNETCORE_PORT, mặc định 8080)
# Lưu ý Windows/macOS + Docker Desktop: nếu 127.0.0.2/127.0.0.3 không bind/không truy cập được,
# đổi các port này thành 8082/8083 và dùng 127.0.0.1:8082 / 127.0.0.1:8083 (hoặc dùng hostname trong hosts).
ASPNETCORE_PORT=8080
WEB_PORT_ADMIN=80
WEB_PORT_MANAGER=80
WEB_PORT_USER=80

ASPNETCORE_ENVIRONMENT=Development
