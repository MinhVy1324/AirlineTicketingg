# Copy this file to .env and replace the placeholder before starting Compose.
POSTGRES_DB=airline_ticketing
POSTGRES_USER=airline_app
POSTGRES_PASSWORD=replace-with-a-unique-random-secret
POSTGRES_PORT=5432

# Every instance below serves the same application, only the landing area differs:
#   :8080 -> all areas      :8081 -> customer flow
#   :8082 -> admin area     :8083 -> manager area
ASPNETCORE_PORT=8080
WEB_PORT_USER=8081
WEB_PORT_ADMIN=8082
WEB_PORT_MANAGER=8083

ASPNETCORE_ENVIRONMENT=Development
