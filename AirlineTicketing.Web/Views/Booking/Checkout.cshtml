@model BookingViewModel
@{
    ViewData["Title"] = "Kiểm tra & thanh toán";
    ViewData["Nav"] = "book";
    var flight = Model.Flight;
    var passengerName = Model.Passenger.FullName;
}

<div class="av-page av-container">
    <partial name="_Stepper" model="3" />

    <header class="booking-title">
        <h1 class="av-page-title">Kiểm tra &amp; thanh toán</h1>
        <p class="av-page-subtitle">Vui lòng kiểm tra lần cuối trước khi hoàn tất đặt vé.</p>
    </header>

    <div class="av-alert av-alert--warning">
        <span class="av-alert__icon">@Html.Icon("alert", 20)</span>
        <div class="av-alert__body">
            <span class="av-alert__title">
                Giữ chỗ đến @Model.HoldUntilText (UTC+7) · @Model.HoldRemainingText
            </span>
            <span>Giá và chỗ chỉ được đảm bảo sau khi thanh toán thành công. Ghế được giữ tạm trong 15 phút kể từ khi bắt đầu thanh toán.</span>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.PaymentError))
    {
        <div class="av-alert av-alert--danger" role="alert">
            <span class="av-alert__icon">@Html.Icon("alert", 20)</span>
            <div class="av-alert__body">
                <span class="av-alert__title">Thông tin thanh toán chưa hợp lệ</span>
                <span>@Model.PaymentError</span>
            </div>
        </div>
    }

    <form class="booking-layout" method="post" asp-controller="Booking" asp-action="Checkout">
        @Html.AntiForgeryToken()

        <div class="booking-main">
            <section class="av-card passenger-block">
                <div class="passenger-block__head">
                    <h2 class="passenger-block__title">Hành trình &amp; hành khách</h2>
                    <a class="av-link" href="/dat-ve/hanh-khach">Chỉnh sửa</a>
                </div>

                <div class="av-row av-row--between av-gap-16">
                    <div class="av-stack av-gap-6">
                        <span class="av-title-20">@Model.Criteria.ShortRouteText</span>
                        <span class="av-caption">
                            @flight.FlightNumber · @Model.Criteria.DepartDateText ·
                            @Money.Time(flight.Departure)–@Money.Time(flight.Arrival) · UTC+7
                        </span>
                    </div>
                    <span class="av-badge av-badge--info">@flight.FareName</span>
                </div>

                <hr class="av-divider" />

                <div class="av-rows">
                    <div class="av-rowline">
                        <span class="av-rowline__label">Hành khách</span>
                        <span class="av-rowline__value">@passengerName</span>
                    </div>
                    <div class="av-rowline">
                        <span class="av-rowline__label">Chỗ ngồi</span>
                        <span class="av-rowline__value">@Model.SeatCode · @Model.SeatTypeName</span>
                    </div>
                    <div class="av-rowline">
                        <span class="av-rowline__label">Hành lý ký gửi</span>
                        <span class="av-rowline__value">@Model.BaggageText</span>
                    </div>
                    <div class="av-rowline">
                        <span class="av-rowline__label">Email nhận vé</span>
                        <span class="av-rowline__value">@Model.Passenger.Email</span>
                    </div>
                    <div class="av-rowline">
                        <span class="av-rowline__label">Số điện thoại</span>
                        <span class="av-rowline__value">@Model.Passenger.Phone</span>
                    </div>
                </div>
            </section>

            <section class="av-card passenger-block">
                <div class="av-card__head-main">
                    <h2 class="passenger-block__title">Phương thức thanh toán</h2>
                    <p class="av-page-subtitle">Giao diện minh họa · Không thu thập thông tin thẻ thật.</p>
                </div>

                <div class="pay-methods" data-payment-methods>
                    <label class="av-chip @(Model.SelectedPayment == "card" ? "is-active" : null)">
                        <input type="radio" name="payment" value="card" checked="@(Model.SelectedPayment == "card")" class="av-visually-hidden" data-payment-input />
                        <span>◉ Thẻ ngân hàng (Visa/Mastercard)</span>
                    </label>
                    <label class="av-chip @(Model.SelectedPayment == "transfer" ? "is-active" : null)">
                        <input type="radio" name="payment" value="transfer" checked="@(Model.SelectedPayment == "transfer")" class="av-visually-hidden" data-payment-input />
                        <span>○ Chuyển khoản / QR</span>
                    </label>
                </div>

                <div data-card-fields class="payment-fields @(Model.SelectedPayment == "card" ? null : "is-hidden")">
                    <div class="card-brands">
                        <span class="av-badge av-badge--info">VISA</span>
                        <span class="av-badge av-badge--neutral">Mastercard</span>
                        <span class="av-badge av-badge--neutral">Nội địa NAPAS</span>
                    </div>

                    <label class="av-field">
                        <span class="av-label">Số thẻ</span>
                        <span class="av-control">
                            <input type="text" name="cardNumber" value="4242 4242 4242 4242" inputmode="numeric"
                                   autocomplete="cc-number" maxlength="23" placeholder="4242 4242 4242 4242" data-card-number />
                            @Html.Icon("credit-card", 17)
                        </span>
                    </label>

                    <div class="form-grid form-grid--3">
                        <label class="av-field">
                            <span class="av-label">Tên chủ thẻ</span>
                            <span class="av-control">
                                <input type="text" name="cardHolder" value="@passengerName" autocomplete="cc-name" />
                            </span>
                        </label>
                        <label class="av-field">
                            <span class="av-label">Ngày hết hạn</span>
                            <span class="av-control">
                                <input type="text" name="cardExpiry" value="12/28" autocomplete="cc-exp" placeholder="MM/YY" />
                            </span>
                        </label>
                        <label class="av-field">
                            <span class="av-label">CVV</span>
                            <span class="av-control">
                                <input type="password" name="cardCvv" value="123" autocomplete="cc-csc" inputmode="numeric" maxlength="4" />
                                @Html.Icon("lock", 17)
                            </span>
                        </label>
                    </div>

                    <p class="av-caption">
                        Thanh toán được xử lý qua cổng VNPay. Không lưu số thẻ hoặc mã bảo mật tại AeroViet.
                        Thẻ Visa/Mastercard hợp lệ được chấp nhận ở cả chế độ thử nghiệm.
                    </p>
                </div>

                <div class="transfer-box payment-fields @(Model.SelectedPayment == "transfer" ? null : "is-hidden")" data-transfer-fields>
                    <span class="transfer-box__icon">@Html.Icon("qr", 22)</span>
                    <div class="transfer-box__body">
                        <span class="transfer-box__title">Chuyển khoản bằng mã QR VietQR</span>
                        <span class="transfer-box__text">
                            Sau khi bấm thanh toán, hệ thống tạo đặt chỗ và hiển thị mã QR kèm số tiền,
                            nội dung chuyển khoản. Ghế được giữ trong 15 phút cho đến khi bạn xác nhận.
                        </span>
                        <span class="av-caption">Ngân hàng: @VietQr.BankName · STK @VietQr.AccountNumber · @VietQr.AccountName</span>
                    </div>
                </div>
            </section>

            <div class="checkout-terms">
                <label class="av-check">
                    <input type="checkbox" name="acceptTerms" value="true" required />
                    <span>
                        Tôi đã kiểm tra thông tin hành khách, đồng ý điều kiện vé, điều kiện vận chuyển và
                        chính sách bảo mật của AeroViet.
                    </span>
                </label>

                <div class="pay-actions">
                    <a class="av-btn av-btn--outline" href="/dat-ve/hanh-khach">
                        @Html.Icon("arrow-left", 17)
                        <span>Quay lại hành khách</span>
                    </a>
                    <button type="submit" class="av-btn av-btn--primary av-btn--lg">
                        @Html.Icon("lock", 17)
                        <span>Thanh toán @Money.Vnd(Model.Price.Total)</span>
                    </button>
                </div>
            </div>
        </div>

        <aside class="booking-aside">
            <partial name="_PriceSummary" model="Model.Price" />

            <section class="av-card">
                <div class="av-card__body av-card__stack">
                    <h2 class="av-card__title">Điều kiện vé</h2>
                    <div class="av-rows">
                        <p class="av-caption">
                            Đổi vé: phí @Money.Vnd(flight.ChangeFee)/khách + chênh lệch giá. Hoàn vé: phí
                            @Money.Vnd(flight.RefundFee)/khách.
                        </p>
                        <p class="av-caption">
                            Yêu cầu trước giờ bay ít nhất 3 tiếng. Không đổi/hoàn khi không có mặt.
                        </p>
                        <p class="av-micro">Phí dịch vụ và hành lý mua thêm không hoàn. Số tiền cuối cùng được xác nhận khi xử lý.</p>
                    </div>
                </div>
            </section>

            <div class="av-alert av-alert--info">
                <span class="av-alert__icon">@Html.Icon("headset", 20)</span>
                <div class="av-alert__body">
                    <span class="av-alert__title">Cần hỗ trợ thanh toán?</span>
                    <span>Gọi 1900 6868 và cung cấp mã @Model.Pnr.</span>
                </div>
            </div>
        </aside>
    </form>
</div>
