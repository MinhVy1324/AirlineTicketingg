                <fieldset class="payment-method-picker">
                    <legend class="passenger-block__title">@T("Phương thức thanh toán", "Payment method")</legend>
                    @if (Model.PendingPayment is not null)
                    {
                        <p class="av-caption">@T("Đặt chỗ đã có giao dịch đang chờ. Tiếp tục bằng phương thức đã chọn.", "A payment is already pending for this booking. Continue using the selected method.")</p>
                    }
                    <div class="pay-methods">
                        @foreach (var (value, name, description, icon) in methods)
                        {
                            var available = CanUse(value);
                            <label class="payment-method">
                                <input type="radio" name="payment" value="@value" disabled="@(!available)"
                                       checked="@(Model.SelectedPayment == value)" class="av-visually-hidden" data-payment-input />
                                <span class="payment-method__icon">@Html.Icon(icon, 20)</span>
                                <span class="av-stack av-gap-3">
                                    <strong>@name</strong>
                                    <span class="av-caption">@description</span>
                                </span>
                            </label>
                        }
                    </div>
                </fieldset>

                @if (Vnpay.Value.Ready || Model.PendingPayment == "vnpay")
