@model BookingViewModel
@inject BookingPromotion Promotion
@using AirlineTicketing.Web.Infrastructure.Payments
@inject Microsoft.Extensions.Options.IOptions<VnpayOptions> Vnpay
@{
    var supportHotline = ViewData["SupportHotline"];
    ViewData["Title"] = T("Kiểm tra & thanh toán", "Review & pay");
    ViewData["Nav"] = "book";
    var flight = Model.Flight;
    var passengerName = Model.Passenger.FullName;
    bool CanUse(string method) => (Model.PendingPayment is null || Model.PendingPayment == method)
        && (method != "vnpay" || Vnpay.Value.Ready);
    var methods = new[]
    {
        ("card", T("Thẻ mô phỏng", "Test card"), T("Dùng Visa hoặc Mastercard mẫu", "Use a test Visa or Mastercard"), "credit-card"),
        ("transfer", "VietQR demo", T("Chờ nhân viên đối soát", "Staff verification required"), "qr"),
        ("vnpay", "VNPAY Sandbox", Vnpay.Value.Ready ? T("Chuyển sang cổng thử nghiệm", "Go to the test gateway") : T("Chưa cấu hình cổng", "Gateway unavailable"), "wallet")
    };
    var cardLabel = T($"Thanh toán mô phỏng {Money.Vnd(Model.Price.Total)}", $"Simulate payment of {Money.Vnd(Model.Price.Total)}");
    var transferLabel = Model.PendingPayment == "transfer" ? T("Mở lại mã QR demo", "Reopen demo QR code") : T("Mở mã QR demo", "Open demo QR code");
    var submitLabel = Model.SelectedPayment switch
    {
        "transfer" => transferLabel,
        "vnpay" => T("Tiếp tục đến VNPAY Sandbox", "Continue to VNPAY Sandbox"),
        _ => cardLabel
    };
}

