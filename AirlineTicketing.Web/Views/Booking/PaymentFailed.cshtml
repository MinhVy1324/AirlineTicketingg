    <partial name="_StatusGrid" model="Model.Statuses" />

    <div class="av-alert av-alert--warning">
        <span class="av-alert__icon">@Html.Icon("clock", 20)</span>
        <div class="av-alert__body">
            <span class="av-alert__title">
                @T("Giữ chỗ đến", "Hold expires at") @BookingUiText.DateTimeText(booking.HoldUntilText) (UTC+7) · @BookingUiText.HoldRemaining(booking.HoldRemainingText)
            </span>
            <span>
                @T("Chỗ và mức giá đã chốt được giữ đến thời hạn trên. Chỉ thử lại khi vẫn còn thời gian giữ chỗ; hết hạn cần tìm lại chuyến.", "Your seats and fare are held until the time shown. Retry while the hold is active. Search for flights again after it expires.")
            </span>
        </div>
    </div>

    <div class="booking-layout">
        <div class="booking-main">
            <section class="av-card">
                <div class="av-card__body av-stack av-gap-16">
                    <h2 class="av-card__title">@T("Hành trình & hành khách", "Itinerary & passengers")</h2>

                    <partial name="_JourneyBlock" model="flight" />

                    <hr class="av-divider" />

                    <div class="av-rows">
                        <div class="av-rowline">
                            <span class="av-rowline__label">@T("Hành khách", "Passenger")</span>
                            <span class="av-rowline__value">@booking.Passenger.FullName</span>
                        </div>
                        <div class="av-rowline">
                            <span class="av-rowline__label">@T("Chỗ ngồi / hành lý", "Seat / baggage")</span>
                            <span class="av-rowline__value">@booking.SeatCode · @T("12 kg xách tay + 33 kg ký gửi", "12 kg carry-on + 33 kg checked baggage")</span>
                        </div>
                        <div class="av-rowline">
                            <span class="av-rowline__label">@T("Liên hệ", "Contact")</span>
                            <span class="av-rowline__value">@booking.Email</span>
                        </div>
                    </div>
                </div>
            </section>

            <section class="av-card">
                <div class="av-card__body av-stack av-gap-16">
                    <div class="av-stack av-gap-6">
                        <h2 class="av-card__title">@T("Thử lại thanh toán", "Retry payment")</h2>
                        <span class="av-caption">@T("Không tạo thêm đặt chỗ khi thử lại trong thời hạn giữ chỗ.", "Retrying during the hold does not create another booking.")</span>
                    </div>

                    <label class="av-field">
                        <span class="av-label">@T("Phương thức vừa sử dụng", "Previous payment method")</span>
                        <span class="av-control">
                            <input type="text" value="@BookingUiText.Text(booking.PaymentMethod) · @card" readonly />
                            @Html.Icon("credit-card", 17)
                        </span>
                    </label>

                    <p class="av-caption">
                        @T("Kiểm tra hạn mức thanh toán trực tuyến hoặc liên hệ ngân hàng phát hành. Bạn cũng có thể chuyển sang chuyển khoản / QR.", "Check your online payment limit or contact the card issuer. You can also switch to bank transfer or QR payment.")
                    </p>

                    <div class="av-row av-gap-12 av-wrap">
                        <a class="av-btn av-btn--primary" href="/dat-ve/thanh-toan">@T("Thử lại thanh toán", "Retry payment")</a>
                        <a class="av-btn av-btn--outline" href="/dat-ve/thanh-toan">@T("Chọn phương thức khác", "Choose another method")</a>
                    </div>
                </div>
            </section>
        </div>

        <aside class="booking-aside">
            <partial name="_PriceSummary" model="booking.Price" />

            <div class="av-alert av-alert--info">
                <span class="av-alert__icon">@Html.Icon("headset", 20)</span>
                <div class="av-alert__body">
