    ViewData["Nav"] = "book";
    var booking = Model.Booking;
    var flight = booking.Flight;
    var card = $"{booking.CardBrand} ••••{booking.CardLast4}";
}

<div class="av-page av-container">
    <partial name="_Stepper" model="3" />

    <header class="booking-title">
        <h1 class="av-page-title">@T("Thanh toán chưa thành công", "Payment unsuccessful")</h1>
        <p class="av-page-subtitle">
            @T("Mã đặt chỗ", "Booking reference") @booking.Pnr · @T("Cập nhật lúc", "Updated") @BookingUiText.DateTimeText(Model.UpdatedAtText) (UTC+7)
        </p>
    </header>

