@model BookingOutcomeViewModel
@{
    ViewData["Title"] = T("Đặt chỗ đã hết hạn", "Booking expired");
    ViewData["Nav"] = "book";
    var booking = Model.Booking;
    var flight = booking.Flight;
}

<div class="av-page av-container">
    <header class="booking-title">
        <h1 class="av-page-title">@T("Đặt chỗ đã hết hạn", "Booking expired")</h1>
        <p class="av-page-subtitle">
            @T("Mã giữ chỗ", "Booking reference") @booking.Pnr · @T("Cập nhật lúc", "Updated") @BookingUiText.DateTimeText(Model.UpdatedAtText) (UTC+7)
        </p>
    </header>

    <div class="av-alert av-alert--warning">
        <span class="av-alert__icon">@Html.Icon("alert", 20)</span>
        <div class="av-alert__body">
            <span class="av-alert__title">@T("Chỗ đã được giải phóng lúc 09:45", "Seats were released at 09:45")</span>
            <span>
                @T("Đã quá thời hạn giữ chỗ và chưa thực hiện thanh toán. Bạn không thể thanh toán cho chỗ và mức giá cũ. Vui lòng tìm lại chuyến để kiểm tra chỗ và giá hiện tại.", "The hold expired before payment. Search for flights again to see current prices and availability.")
            </span>
        </div>
    </div>

    <partial name="_StatusGrid" model="Model.Statuses" />

    <div class="booking-layout">
        <div class="booking-main">
            <section class="av-card">
                <div class="av-card__body av-stack av-gap-16">
                    <h2 class="av-card__title">@T("Hành trình đã giữ", "Held itinerary")</h2>

                    <partial name="_JourneyBlock" model="flight" />

                    <hr class="av-divider" />

                    <div class="av-rows">
                        <div class="av-rowline">
                            <span class="av-rowline__label">@T("Hành khách", "Passenger")</span>
                            <span class="av-rowline__value">@booking.Passenger.FullName</span>
                        </div>
                        <div class="av-rowline">
                            <span class="av-rowline__label">@T("Tổng tiền trước khi hết hạn", "Total before expiry")</span>
                            <span class="av-rowline__value">@Money.Vnd(booking.Price.Total)</span>
                        </div>
                    </div>

                    <p class="av-caption">
                        @T("Số tiền trên chỉ là thông tin của đặt chỗ đã hết hạn, không phải giá đang có hiệu lực.", "The amount above is for the expired booking. Check current fares when searching again.")
                    </p>
                </div>
            </section>

            <section class="av-card">
                <div class="av-card__body av-stack av-gap-16">
                    <div class="av-stack av-gap-6">
                        <h2 class="av-card__title">@T("Đặt lại hành trình", "Rebook your trip")</h2>
                        <span class="av-caption">
                            @T("Chọn lại chuyến phù hợp. Giá và chỗ được xác nhận lại trước khi tạo giữ chỗ mới.", "Choose another flight. The fare and availability will be checked before a new hold is created.")
                        </span>
                    </div>

                    <label class="av-check">
                        <input type="checkbox" checked disabled />
                        <span>@T("Dùng lại thông tin hành khách đã nhập", "Reuse the passenger details")</span>
                    </label>

                    <p class="av-caption">
                        @T("Bạn cần kiểm tra lại tên theo giấy tờ, email, số điện thoại và lựa chọn hành lý trước khi tiếp tục.", "Review the name on the ID, email, phone number and baggage selection before continuing.")
                    </p>

                    <div class="av-row av-gap-12 av-wrap">
                        <a class="av-btn av-btn--primary" href="/chuyen-bay">@T("Tìm lại chuyến SGN → HAN", "Find SGN → HAN flights again")</a>
                        <a class="av-btn av-btn--outline" href="/">@T("Về trang chủ", "Back to home")</a>
                    </div>
                </div>
            </section>
        </div>

        <aside class="booking-aside">
            <partial name="_TimelineLog" model="Model" />

            <div class="av-alert av-alert--info">
                <span class="av-alert__icon">@Html.Icon("headset", 20)</span>
                <div class="av-alert__body">
