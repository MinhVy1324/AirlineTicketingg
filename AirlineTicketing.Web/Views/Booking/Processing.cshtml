@model BookingOutcomeViewModel
@{
    var supportHotline = ViewData["SupportHotline"];
    ViewData["Title"] = T("Đã thanh toán, đang xuất vé", "Paid, issuing your ticket");
    ViewData["Nav"] = "book";
    var booking = Model.Booking;
    var flight = booking.Flight;
    var card = $"{booking.CardBrand} ••••{booking.CardLast4}";
}

<div class="av-page av-container">
    <partial name="_Stepper" model="3" />

    <header class="booking-title">
        <h1 class="av-page-title">@T("Đã thanh toán, đang xuất vé", "Paid, issuing your ticket")</h1>
        <p class="av-page-subtitle">
            @T("Mã đặt chỗ", "Booking reference") @booking.Pnr · @T("Cập nhật lúc", "Updated") @BookingUiText.DateTimeText(Model.UpdatedAtText) (UTC+7)
        </p>
    </header>

    <div class="av-alert av-alert--success">
        <span class="av-alert__icon">@Html.Icon("check-circle", 20)</span>
        <div class="av-alert__body">
            <span class="av-alert__title">@T("Giao dịch thanh toán thành công", "Payment successful") · @Money.Vnd(booking.Price.Total)</span>
            <span>
                @T($"Cổng thanh toán đã xác nhận giao dịch {booking.TransactionCode} qua {card} lúc 09:42. Không thanh toán lại cho đặt chỗ này.", $"The payment gateway confirmed transaction {booking.TransactionCode} with {card} at 09:42. Do not pay again for this booking.")
            </span>
        </div>
    </div>

    <partial name="_StatusGrid" model="Model.Statuses" />

    <div class="booking-layout">
        <div class="booking-main">
            <section class="av-card">
                <div class="av-card__body av-stack av-gap-16">
                    <div class="av-stack av-gap-6">
                        <h2 class="av-card__title">@T("Đặt chỗ", "Booking") · @booking.Pnr</h2>
                        <span class="av-caption">@T("Tạo lúc", "Created") @BookingUiText.DateTimeText(booking.CreatedAtText) (UTC+7)</span>
                    </div>

                    <partial name="_JourneyBlock" model="flight" />

                    <hr class="av-divider" />

                    <div class="av-rows">
                        <div class="av-rowline">
                            <span class="av-rowline__label">@T("Hành khách", "Passenger")</span>
                            <span class="av-rowline__value">@booking.Passenger.FullName</span>
                        </div>
                        <div class="av-rowline">
                            <span class="av-rowline__label">@T("Ghế / hành lý", "Seat / baggage")</span>
                            <span class="av-rowline__value">@booking.SeatCode · @T("12 kg xách tay + 33 kg ký gửi", "12 kg carry-on + 33 kg checked baggage")</span>
                        </div>
                        <div class="av-rowline">
                            <span class="av-rowline__label">@T("Email nhận thông báo", "Notification email")</span>
                            <span class="av-rowline__value">@booking.Email</span>
                        </div>
                        <div class="av-rowline av-rowline--total">
                            <span class="av-rowline__label">@T("Tổng đã thanh toán", "Total paid")</span>
                            <span class="av-rowline__value">@Money.Vnd(booking.Price.Total)</span>
                        </div>
                    </div>
                </div>
            </section>

            <div class="av-alert av-alert--info">
                <span class="av-alert__icon">@Html.Icon("info", 20)</span>
                <div class="av-alert__body">
                    <span class="av-alert__title">@T("Chưa phải xác nhận đã có vé", "Ticket not yet issued")</span>
                    <span>
                        @T("Đặt chỗ đã được thanh toán nhưng vé chưa được phát hành. Chưa có số vé và chưa thể tải vé điện tử. Vé sẽ gửi đến email của bạn sau khi xuất thành công.", "Your booking is paid, and your ticket is still being issued. The ticket number and PDF will be available once we send the ticket to your email.")
                    </span>
                </div>
            </div>

            <div class="av-row av-gap-12 av-wrap">
                <a class="av-btn av-btn--primary" href="/ve-cua-toi">@T("Kiểm tra đặt chỗ", "Check booking")</a>
                <a class="av-btn av-btn--outline" href="tel:19006868">@T("Liên hệ hỗ trợ", "Contact support")</a>
            </div>
        </div>

        <aside class="booking-aside">
            <partial name="_TimelineLog" model="Model" />

            <div class="av-alert av-alert--warning">
                <span class="av-alert__icon">@Html.Icon("alert", 20)</span>
                <div class="av-alert__body">
                    <span class="av-alert__title">@T("Nếu chờ quá 15 phút", "If you have waited more than 15 minutes")</span>
                    <span>
<<<<<<< Updated upstream
                        Kiểm tra lại đặt chỗ. Nếu vẫn chưa có vé, gọi 1900 6868 và cung cấp @booking.Pnr cùng mã giao dịch.
                        Không thực hiện thanh toán lần nữa.
=======
                        @T($"Kiểm tra lại đặt chỗ. Nếu vẫn chưa có vé, gọi {supportHotline} và cung cấp {booking.Pnr} cùng mã giao dịch. Không thực hiện thanh toán lần nữa.", $"Check your booking again. If your ticket is still pending, call {supportHotline} with reference {booking.Pnr} and the transaction code. Do not pay again.")
>>>>>>> Stashed changes
                    </span>
                </div>
            </div>
        </aside>
    </div>
</div>
