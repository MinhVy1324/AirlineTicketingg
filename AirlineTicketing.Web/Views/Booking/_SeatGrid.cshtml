@model SeatGridViewModel
@{
    var gridId = $"{Model.Id}-grid";
    var helpId = $"{Model.Id}-keyboard-help";
}
<div class="seatmap" role="group" aria-label="@T("Sơ đồ chỗ ngồi", "Seat map")">
    <p class="av-caption" id="@helpId">@T("Dùng phím mũi tên để di chuyển, Enter hoặc phím cách để chọn ghế.", "Use the arrow keys to move and press Enter or Space to select a seat.")</p>
    <div class="seatmap__cols" aria-hidden="true">
        <span class="seatmap__col">A</span>
        <span class="seatmap__col">B</span>
        <span class="seatmap__col">C</span>
        <span></span>
        <span class="seatmap__col">D</span>
        <span class="seatmap__col">E</span>
        <span class="seatmap__col">F</span>
    </div>

    <div class="seatmap__scroll" id="@gridId" data-seat-grid aria-describedby="@helpId">
        @foreach (var row in Model.Rows)
        {
            <div class="seatmap__row">
                @for (var i = 0; i < row.Seats.Count; i++)
                {
                    if (i == 3)
                    {
                        <span class="seatmap__aisle" aria-hidden="true">@row.Number</span>
                    }

                    var seat = row.Seats[i];
                    var cls = seat.State switch
                    {
                        SeatState.Selected => "seat is-selected",
                        SeatState.Taken => "seat is-taken",
                        _ => "seat"
                    };
                    cls += $" seat--{seat.Type.ToLowerInvariant()}";
                    var label = seat.State switch
                    {
                        SeatState.Selected => "✓",
                        SeatState.Taken => "×",
                        _ => seat.Label
                    };
                    <button type="button" class="@cls"
                            data-seat-code="@seat.Code" data-seat-letter="@seat.Label"
                            data-seat-type="@seat.Type"
                            data-seat-type-name="@BookingUiText.Text(seat.TypeName)"
                            data-seat-surcharge="@seat.Surcharge.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                            data-seat-position="@BookingUiText.Text(seat.Position)"
                            title="@T("Ghế", "Seat") @seat.Code · @BookingUiText.Text(seat.TypeName)@(seat.Surcharge > 0 ? $" · +{Money.Vnd(seat.Surcharge)}" : "")"
                            aria-label="@T("Ghế", "Seat") @seat.Code · @BookingUiText.Text(seat.TypeName)"
                            aria-pressed="@(seat.State == SeatState.Selected ? "true" : "false")"
                            disabled="@(seat.State == SeatState.Taken)">
                        @label
                    </button>
                }
            </div>
        }
    </div>

    <p class="av-micro">@T($"Sơ đồ đủ {Model.Rows.Sum(x => x.Seats.Count)} ghế theo tàu bay {Model.Aircraft}.", $"Seat map of all {Model.Rows.Sum(x => x.Seats.Count)} seats on the {Model.Aircraft}.")</p>
</div>
