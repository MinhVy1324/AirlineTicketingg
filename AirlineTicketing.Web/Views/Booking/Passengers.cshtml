@model BookingViewModel
@{
    ViewData["Title"] = T("Hành khách & dịch vụ", "Passengers & extras");
    ViewData["Nav"] = "book";
}

<div class="av-page av-container">
    <partial name="_Stepper" model="2" />

    <header class="booking-title">
        <h1 class="av-page-title">@T("Thông tin hành khách", "Passenger details")</h1>
        <p class="av-page-subtitle">@T("Nhập đúng thông tin trên giấy tờ tùy thân dùng để làm thủ tục bay.", "Enter the details exactly as they appear on the ID you will use to check in.")</p>
    </header>

    @if (Model.ValidationErrors.Count > 0)
    {
        <div class="av-alert av-alert--danger" role="alert" tabindex="-1" data-validation-summary>
            <span class="av-alert__icon">@Html.Icon("alert", 20)</span>
            <div class="av-alert__body">
                <span class="av-alert__title">@T("Vui lòng kiểm tra thông tin trước khi tiếp tục", "Review your details before continuing")</span>
                <ul>
                    @foreach (var error in Model.ValidationErrors)
                    {
                        <li><a href="#@error.Key">@BookingUiText.Text(error.Value)</a></li>
                    }
                </ul>
            </div>
        </div>
    }

    <form class="booking-layout" method="post" asp-controller="Booking" asp-action="Passengers">
        @Html.AntiForgeryToken()

        <div class="booking-main">
            <section class="av-card passenger-block">
                <div class="passenger-block__head">
                    <h2 class="passenger-block__title">@T("Hành khách 1 · Người lớn", "Passenger 1 · Adult")</h2>
                    <span class="av-caption">@T("Từ 12 tuổi tại ngày bay", "Aged 12 or older on the flight date")</span>
                </div>

                <div class="form-grid form-grid--3">
                    <label class="av-field">
                        <span class="av-label">@T("Họ", "Surname") <span class="req">*</span></span>
                        <span class="av-control">
                            <input id="lastName" type="text" name="lastName" value="@Model.Passenger.LastName" autocomplete="family-name" maxlength="70" required aria-invalid="@(Model.ErrorFor("lastName") is not null ? "true" : "false")" />
                        </span>
                        <span class="av-field__error">@BookingUiText.Text(Model.ErrorFor("lastName"))</span>
                    </label>
                    <label class="av-field">
                        <span class="av-label">@T("Tên đệm và tên", "Middle and given names") <span class="req">*</span></span>
                        <span class="av-control">
                            <input id="firstName" type="text" name="firstName" value="@Model.Passenger.FirstName" autocomplete="given-name" maxlength="70" required aria-invalid="@(Model.ErrorFor("firstName") is not null ? "true" : "false")" />
                        </span>
                    </label>
                    <label class="av-field">
                        <span class="av-label">@T("Giới tính", "Gender") <span class="req">*</span></span>
                        <span class="av-control">
                            <select id="gender" name="gender" required>
                                <option value="Nữ" selected="@(Model.Passenger.Gender == "Nữ")">@T("Nữ", "Female")</option>
                                <option value="Nam" selected="@(Model.Passenger.Gender == "Nam")">@T("Nam", "Male")</option>
                                <option value="Khác" selected="@(Model.Passenger.Gender == "Khác")">@T("Khác", "Other")</option>
                            </select>
                            @Html.Icon("chevron-down", 17)
                        </span>
                    </label>
                </div>

                <div class="form-grid form-grid--3">
                    <label class="av-field">
                        <span class="av-label">@T("Ngày sinh", "Date of birth") <span class="req">*</span></span>
                        <span class="av-control">
                            <input id="dateOfBirth" type="text" name="dateOfBirth" value="@Model.Passenger.DateOfBirth" autocomplete="bday" placeholder="dd/MM/yyyy" maxlength="10" required />
                            @Html.Icon("calendar", 17)
                        </span>
                    </label>
                    <label class="av-field">
                        <span class="av-label">@T("Quốc tịch", "Nationality") <span class="req">*</span></span>
                        <span class="av-control">
                            <input id="nationality" type="text" name="nationality" value="@Model.Passenger.Nationality" maxlength="100" required />
                        </span>
                    </label>
                    <label class="av-field">
                        <span class="av-label">@T("CCCD / Hộ chiếu", "ID card / passport") <span class="req">*</span></span>
                        <span class="av-control @(Model.ErrorFor("identityNumber") is not null ? "is-invalid" : null)">
                            <input id="identityNumber" type="text" name="identityNumber" value="@Model.Passenger.IdentityNumber" minlength="6" maxlength="30" required />
                        </span>
                        @if (Model.ErrorFor("identityNumber") is string identityError)
                        {
                            <span class="av-field__error">@BookingUiText.Text(identityError)</span>
                        }
                    </label>
                </div>

                <p class="av-caption">@T("Nhập đúng họ tên và giấy tờ của người đi chuyến bay. Hỗ trợ họ tên tiếng Việt có dấu.", "Enter the passenger's name and ID exactly as shown on their document. Vietnamese accents are accepted.")</p>
            </section>

            <section class="av-card passenger-block">
                <div class="av-card__head-main">
                    <h2 class="passenger-block__title">@T("Thông tin liên hệ", "Contact details")</h2>
                    <p class="av-page-subtitle">@T("Vé điện tử và cập nhật chuyến bay sẽ gửi đến thông tin này.", "We will use these details to send your e-ticket and flight updates.")</p>
                </div>

                <div class="form-grid form-grid--2">
                    <label class="av-field">
                        <span class="av-label">Email <span class="req">*</span></span>
                        <span class="av-control @(Model.ErrorFor("email") is not null ? "is-invalid" : null)">
                            <input id="email" type="email" name="email" value="@Model.Passenger.Email" autocomplete="email" maxlength="254" required />
                            @Html.Icon("mail", 17)
                        </span>
                        @if (Model.ErrorFor("email") is string emailError)
                        {
                            <span class="av-field__error">@BookingUiText.Text(emailError)</span>
                        }
                    </label>
                    <label class="av-field">
                        <span class="av-label">@T("Số điện thoại", "Phone number") <span class="req">*</span></span>
                        <span class="av-control">
                            <input id="phone" type="tel" name="phone" value="@Model.Passenger.Phone" autocomplete="tel" maxlength="20" required />
                            @Html.Icon("phone", 17)
                        </span>
                    </label>
                </div>
            </section>

            <section class="av-card passenger-block">
                <h2 class="passenger-block__title">@T("Hành lý & chỗ ngồi", "Baggage & seating")</h2>

                <div class="baggage-row">
                    <div class="baggage-row__info">
