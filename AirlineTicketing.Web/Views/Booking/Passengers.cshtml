            </div>

            @if (Model.ValidationErrors.Count > 0)
            {
                <p class="av-caption">@T("Các thông tin bạn đã nhập được giữ lại. Sửa các mục được thông báo rồi gửi lại.", "Your information has been retained. Fix the fields shown and resubmit.")</p>
            }
        </div>

        <aside class="booking-aside">
            <section class="av-card">
                <div class="av-card__body summary-flight">
                    <h2 class="av-card__title">@T("Hành trình của bạn", "Your itinerary")</h2>

                    <div class="summary-flight__airline">
                        <span class="summary-flight__airline-name">
                            @Html.Icon("plane", 20)
                            @Model.Flight.AirlineName
                        </span>
                        <span class="av-badge av-badge--neutral">@Model.Flight.FlightNumber</span>
                    </div>

                    <span class="summary-flight__date">@BookingUiText.LongDate(Model.Flight.Departure) · @BookingUiText.Text(Model.Flight.Stops)</span>

                    <partial name="_FlightTimeline" model="new FlightTimelineModel(Model.Flight, ShowAirportName: true)" />

                    <hr class="av-divider" />

                    <span class="av-caption">@BookingUiText.Text(Model.Flight.FareName) · @T("1 người lớn", "1 adult")</span>
                </div>
            </section>

            <partial name="_PriceSummary" model="Model.Price" />

            <div class="av-alert av-alert--success">
                <span class="av-alert__icon">@Html.Icon("shield-check", 20)</span>
                <div class="av-alert__body">
                    <span class="av-alert__title">@T("Thông tin của bạn được bảo vệ", "Your information is protected")</span>
                    <span>@T("Chỉ sử dụng để xuất vé và hỗ trợ hành trình.", "We use it to issue your ticket and support your trip.")</span>
                </div>
            </div>
        </aside>
    </form>
</div>
