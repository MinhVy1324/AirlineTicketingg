    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="av-alert av-alert--@Model.MessageTone" role="@(Model.MessageTone == "danger" ? "alert" : "status")">
            <span class="av-alert__icon">@Html.Icon(Model.MessageTone == "success" ? "check" : "info", 20)</span>
            <div class="av-alert__body"><span>@Model.Message</span></div>
        </div>
    }

    <section class="admin-kpis admin-kpis--compact" aria-label="@T("Thống kê tài khoản", "Account statistics")">
>>>>>>> Stashed changes
        @foreach (var kpi in Model.Stats)
        {
            <article class="admin-kpi admin-kpi--compact">
                <span class="admin-kpi__label">@kpi.Label</span>
                <span class="admin-kpi__value admin-kpi__value--compact">@kpi.Value</span>
            </article>
        }
    </section>

    <section class="av-card admin-card">
        <div class="av-card__body admin-card__body">
            <div class="admin-card__head-main">
                <h2 class="av-card__title">@T("Danh sách tài khoản", "Accounts")</h2>
                <span class="av-caption">@T("Thông tin cá nhân dưới đây là dữ liệu minh họa.", "The personal information below is sample data.")</span>
            </div>

            <form class="admin-filters admin-filters--accounts" method="get" action="/admin/tai-khoan">
                <label class="av-field">
                    <span class="av-label">@T("Tìm kiếm", "Search")</span>
                    <span class="av-control">
                        <input type="search" name="q" placeholder="@Model.SearchPlaceholder" autocomplete="off" />
                        @Html.Icon("search", 17)
                    </span>
                </label>

                <label class="av-field">
                    <span class="av-label">@T("Vai trò", "Role")</span>
                    <span class="av-control">
                        <select name="vai-tro">
                            <option value="@Model.RoleFilter" selected>@T(Model.RoleFilter, "All roles")</option>
                            <option>Admin</option>
                            <option>Manager</option>
                            <option value="Khách hàng">@T("Khách hàng", "Customer")</option>
                        </select>
                        @Html.Icon("chevron-down", 17)
                    </span>
                </label>

                <label class="av-field">
                    <span class="av-label">@T("Trạng thái", "Status")</span>
                    <span class="av-control">
                        <select name="trang-thai">
                            <option value="@Model.StatusFilter" selected>@T(Model.StatusFilter, "All statuses")</option>
                            <option value="Hoạt động">@T("Hoạt động", "Active")</option>
                            <option value="Đã khóa">@T("Đã khóa", "Locked")</option>
                        </select>
                        @Html.Icon("chevron-down", 17)
                    </span>
                </label>

                <button type="submit" class="av-btn av-btn--outline admin-filters__submit">@T("Áp dụng", "Apply")</button>
            </form>

            <div class="admin-table">
                <table class="av-table admin-table--accounts">
                    <thead>
                        <tr>
                            <th scope="col">@T("Tài khoản / Email", "Account / Email")</th>
                            <th scope="col">@T("Vai trò", "Role")</th>
                            <th scope="col">@T("Trạng thái", "Status")</th>
                            <th scope="col">@T("Lần đăng nhập cuối", "Last sign-in")</th>
                            <th scope="col">@T("Thao tác", "Actions")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Accounts)
                        {
                            <tr class="@(row.IsSelected ? "is-selected" : null)">
                                <td>
                                    <span class="admin-account-name">@row.Name</span>
                                    <span class="admin-account-email">@row.Email</span>
                                </td>
                                <td>@(row.Role == nameof(VaiTro.KhachHang) ? T(row.Role, "Customer") : row.Role)</td>
                                <td class="admin-table__result admin-table__result--@row.StatusTone">@row.StatusText</td>
                                <td>@row.LastLogin</td>
                                <td><a class="admin-table__action" href="@row.ActionHref">@row.ActionText</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="av-pagination">
                <span>@Model.ResultText</span>
                <span class="av-pagination__links">
                    <a href="/admin/tai-khoan">@T("Trước", "Previous")</a>
                    <span class="is-current">1</span>
                    <a href="/admin/tai-khoan">@T("Sau", "Next")</a>
                </span>
            </div>
        </div>
    </section>

    <section class="admin-grid admin-grid--detail">
        <article class="av-card admin-card">
            <div class="av-card__body admin-card__body">
                <div class="admin-card__head-main">
                    <h2 class="av-card__title">@Model.Detail.Title</h2>
                    <span class="av-caption">@Model.Detail.Subtitle</span>
                </div>

                <div class="admin-detail-rows">
                    @foreach (var field in Model.Detail.Fields)
                    {
                        <div class="admin-detail-rows__row">
                            <span class="admin-detail-rows__label">@field.Label</span>
                            <span class="admin-detail-rows__value">@field.Value</span>
                        </div>
                    }
                </div>

                <div class="admin-detail-actions">
                    <button type="button" class="av-btn av-btn--ghost">@Model.Detail.PrimaryActionText</button>
                    <a class="av-btn av-btn--ghost admin-text-danger" href="@Model.Detail.DangerActionHref">@Model.Detail.DangerActionText</a>
                </div>
            </div>
        </article>

        <article class="av-card admin-card">
            <div class="av-card__body admin-card__body">
                <h2 class="av-card__title">@T("Kiểm soát truy cập", "Access control")</h2>

                <div class="av-alert av-alert--info">
                    <span class="av-alert__icon">@Html.Icon("shield-check", 20)</span>
                    <div class="av-alert__body">
                        <span class="av-alert__title">@T("Không khóa Admin cuối cùng", "Keep at least one active administrator")</span>
                        <span>
                            @T("Luôn duy trì ít nhất một quản trị viên hoạt động. Mọi thao tác khóa, mở và cấp quyền đều có nhật ký.", "Keep at least one active administrator. Account locks, unlocks and permission changes are recorded in the audit log.")
                        </span>
                    </div>
                </div>

                <p class="av-caption admin-card__note">
                    @T("Khóa tài khoản sẽ kết thúc các phiên hiện tại. Đặt chỗ và dữ liệu lịch sử vẫn được giữ nguyên.", "Locking the account ends current sessions and retains booking and audit history.")
                </p>
            </div>
        </article>
    </section>
</div>

