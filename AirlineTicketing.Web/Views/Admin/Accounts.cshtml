    <header class="admin-page-head">
        <div class="admin-page-head__main">
            <h1 class="admin-page-title">@T("Quản lý tài khoản", "Account management")</h1>
            <p class="admin-page-subtitle">@T("Cấp quyền truy cập phù hợp, theo dõi và bảo vệ tài khoản hệ thống.", "Manage access permissions and monitor system accounts.")</p>
        </div>
        <button type="button" class="av-btn av-btn--primary">
            @Html.Icon("plus", 17)
