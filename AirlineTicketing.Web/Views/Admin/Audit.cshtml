@model AdminAuditViewModel
@{
    ViewData["Title"] = T("Nhật ký hoạt động", "Activity log");
    ViewData["AdminNav"] = "audit";
    string AuditAction(string value) => value switch
    {
        "Tất cả thao tác" => T(value, "All actions"),
        "Cập nhật cấu hình" => T(value, "Update settings"),
        "Xuất vé" => T(value, "Issue tickets"),
        "Thanh toán" => T(value, "Payment"),
        "Đăng nhập" => T(value, "Sign in"),
        _ => value
    };
}

<div class="admin-page">
    <header class="admin-page-head">
        <div class="admin-page-head__main">
            <h1 class="admin-page-title">@T("Nhật ký hoạt động", "Activity log")</h1>
            <p class="admin-page-subtitle">@T("Truy vết ai đã làm gì, thời điểm thực hiện và kết quả xử lý.", "See who performed each action, when it happened and its outcome.")</p>
        </div>
    </header>

    <form class="av-card admin-card" method="get" action="/admin/nhat-ky">
        <div class="av-card__body admin-card__body">
            <div class="admin-filters admin-filters--audit">
                <label class="av-field">
                    <span class="av-label">@T("Thời gian", "Time")</span>
                    <span class="av-control">
                        <input type="text" name="tu-ngay" value="@Model.FromDate – @Model.ToDate" />
                        @Html.Icon("calendar", 17)
                    </span>
                </label>

                <label class="av-field">
                    <span class="av-label">@T("Người thực hiện", "Actor")</span>
                    <span class="av-control">
                        <select name="nguoi-thuc-hien">
                            <option value="@Model.ActorFilter" selected>@(Model.ActorFilter == "Tất cả người dùng" ? T(Model.ActorFilter, "All users") : Model.ActorFilter)</option>
                            <option>Trần Hoàng Tùng / Admin</option>
                            <option>Lê Quốc Long / Manager</option>
                            <option value="Cổng VNPay / Hệ thống">@T("Cổng VNPay / Hệ thống", "VNPAY gateway / System")</option>
                        </select>
                        @Html.Icon("chevron-down", 17)
                    </span>
                </label>

                <label class="av-field">
                    <span class="av-label">@T("Loại thao tác", "Action type")</span>
                    <span class="av-control">
                        <select name="loai-thao-tac">
                            <option value="@Model.TypeFilter" selected>@AuditAction(Model.TypeFilter)</option>
                            <option value="Cập nhật cấu hình">@AuditAction("Cập nhật cấu hình")</option>
                            <option value="Xuất vé">@AuditAction("Xuất vé")</option>
                            <option value="Thanh toán">@AuditAction("Thanh toán")</option>
                            <option value="Đăng nhập">@AuditAction("Đăng nhập")</option>
                        </select>
                        @Html.Icon("chevron-down", 17)
                    </span>
                </label>

                <button type="submit" class="av-btn av-btn--primary admin-filters__submit">
                    @Html.Icon("search", 17)
                    <span>@Model.FilterText</span>
                </button>
            </div>
        </div>
    </form>

    <section class="av-card admin-card">
        <div class="av-card__body admin-card__body">
            <div class="admin-card__head">
                <div class="admin-card__head-main">
                    <h2 class="av-card__title">@T("Sự kiện hệ thống", "System events")</h2>
                    <span class="av-caption">@T("Giờ Việt Nam (UTC+7) · Chỉ đọc, không sửa hoặc xóa", "Vietnam time (UTC+7) · Read-only")</span>
                </div>
