@model AdminCatalogViewModel
@{
    ViewData["Title"] = T("Danh mục hệ thống", "System catalog");
    ViewData["AdminNav"] = "catalog";

    var activeTab = Model.Tabs.FirstOrDefault(tab => tab.IsActive);
    var tabQuery = activeTab?.Key switch
    {
        "airlines" => "hang-bay",
        "routes" => "tuyen-bay",
        "aircraft" => "tau-bay",
        "cabin" => "hang-ghe",
        _ => ""
    };
    Func<string, string> statusTone = status => status is "Tạm dừng" or "Bảo trì" ? "warning" : "success";
    string DisplayStatus(string status) => status switch
    {
        "Tất cả" => T(status, "All"),
        "Tạm dừng" => T(status, "Suspended"),
        "Bảo trì" => T(status, "Maintenance"),
        "Đang khai thác" => T(status, "Active"),
        "Ngừng" => T(status, "Inactive"),
        _ => UiLanguage.Label(status)
    };
}

