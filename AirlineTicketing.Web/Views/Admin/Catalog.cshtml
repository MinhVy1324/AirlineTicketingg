        <div class="admin-page-head__main">
            <h1 class="admin-page-title">@T("Danh mục hệ thống", "System catalog")</h1>
            <p class="admin-page-subtitle">@T("Quản lý dữ liệu nền dùng chung cho tìm kiếm, đặt vé và lịch khai thác.", "Manage shared reference data for search, bookings and flight operations.")</p>
        </div>
        <button type="button" class="av-btn av-btn--primary">
            @Html.Icon("plus", 17)
            <span>@Model.AddText</span>
        </button>
    </header>

