@model IReadOnlyList<TaiKhoanDTO>
@{
    ViewData["Title"] = "Quản lý tài khoản";
    var currentVaiTro = ViewBag.CurrentVaiTro as string;
    var currentKeyword = ViewBag.CurrentKeyword as string;
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold mb-0 text-dark">Quản Lý Tài Khoản & Phân Quyền</h2>
            <small class="text-muted">Quản trị danh sách người dùng, nhân viên bán vé và phân quyền truy cập hệ thống</small>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary fw-semibold">
                + Thêm Tài Khoản Nội Bộ
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Bộ lọc vai trò và tìm kiếm -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-3 align-items-center">
                <div class="col-md-3">
                    <div class="btn-group w-100" role="group">
                        <a asp-action="Index" asp-route-keyword="@currentKeyword" class="btn btn-sm @(string.IsNullOrEmpty(currentVaiTro) ? "btn-dark" : "btn-outline-dark")">Tất cả</a>
                        <a asp-action="Index" asp-route-vaiTro="Admin" asp-route-keyword="@currentKeyword" class="btn btn-sm @(currentVaiTro == "Admin" ? "btn-danger" : "btn-outline-danger")">Admin</a>
                        <a asp-action="Index" asp-route-vaiTro="NhanVien" asp-route-keyword="@currentKeyword" class="btn btn-sm @(currentVaiTro == "NhanVien" ? "btn-info" : "btn-outline-info")">Nhân viên</a>
                        <a asp-action="Index" asp-route-vaiTro="KhachHang" asp-route-keyword="@currentKeyword" class="btn btn-sm @(currentVaiTro == "KhachHang" ? "btn-success" : "btn-outline-success")">Khách hàng</a>
                    </div>
                </div>

                <div class="col-md-6">
                    <input type="hidden" name="vaiTro" value="@currentVaiTro" />
                    <div class="input-group">
                        <input type="text" name="keyword" value="@currentKeyword" class="form-control form-control-sm" placeholder="Tìm theo tên đăng nhập, họ tên, email hoặc SĐT..." />
                        <button type="submit" class="btn btn-sm btn-primary">Tìm kiếm</button>
                        @if (!string.IsNullOrEmpty(currentKeyword))
                        {
                            <a asp-action="Index" asp-route-vaiTro="@currentVaiTro" class="btn btn-sm btn-outline-secondary">Xóa tìm</a>
                        }
                    </div>
                </div>

                <div class="col-md-3 text-end text-muted small">
                    Tổng số: <strong>@Model.Count</strong> tài khoản
                </div>
            </form>
        </div>
    </div>

    <!-- Danh sách người dùng -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Tên Đăng Nhập</th>
                            <th>Họ và Tên</th>
                            <th>Liên Hệ</th>
                            <th>Vai Trò</th>
                            <th>Trạng Thái</th>
                            <th>Ngày Tạo</th>
                            <th class="text-end">Hành Động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var u in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-bold text-dark">@u.TenDangNhap</span>
                                        @if (u.KhachHangId.HasValue)
                                        {
                                            <div class="small text-muted">FK Khách: #@u.KhachHangId</div>
                                        }
                                    </td>
                                    <td>@u.HoTen</td>
                                    <td>
                                        <div>@u.Email</div>
                                        <small class="text-muted">@u.SoDienThoai</small>
                                    </td>
                                    <td>
                                        @if (u.VaiTro == "Admin")
                                        {
                                            <span class="badge bg-danger">Admin Quản Trị</span>
                                        }
                                        else if (u.VaiTro == "NhanVien")
                                        {
                                            <span class="badge bg-info text-dark">Nhân Viên</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Khách Hàng</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge @(u.TrangThai == "HoatDong" ? "bg-success-subtle text-success border border-success" : "bg-danger-subtle text-danger border border-danger")">
                                            @(u.TrangThai == "HoatDong" ? "Hoạt động" : "Bị khóa")
                                        </span>
                                    </td>
                                    <td class="small text-muted">
                                        @u.NgayTao.ToLocalTime().ToString("dd/MM/yyyy")
                                        @if (u.LanDangNhapCuoi.HasValue)
                                        {
                                            <div style="font-size: 0.75rem;">Login: @u.LanDangNhapCuoi.Value.ToLocalTime().ToString("dd/MM HH:mm")</div>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <!-- Khóa/Mở khóa -->
                                            <form asp-action="ToggleStatus" asp-route-id="@u.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn đổi trạng thái tài khoản @u.TenDangNhap?');">
                                                <button type="submit" class="btn @(u.TrangThai == "HoatDong" ? "btn-outline-danger" : "btn-outline-success") btn-sm" title="@(u.TrangThai == "HoatDong" ? "Khóa tài khoản" : "Mở khóa")">
                                                    @(u.TrangThai == "HoatDong" ? "Khóa" : "Mở")
                                                </button>
                                            </form>

                                            <!-- Đổi vai trò Dropdown -->
                                            <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle" data-bs-toggle="dropdown">
                                                Vai trò
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow">
                                                <li><h6 class="dropdown-header">Chuyển sang:</h6></li>
                                                <li>
                                                    <form asp-action="ChangeRole" asp-route-id="@u.Id" asp-route-vaiTro="Admin" method="post">
                                                        <button type="submit" class="dropdown-item @(u.VaiTro == "Admin" ? "active" : "")">Admin</button>
                                                    </form>
                                                </li>
                                                <li>
                                                    <form asp-action="ChangeRole" asp-route-id="@u.Id" asp-route-vaiTro="NhanVien" method="post">
                                                        <button type="submit" class="dropdown-item @(u.VaiTro == "NhanVien" ? "active" : "")">Nhân viên</button>
                                                    </form>
                                                </li>
                                                <li>
                                                    <form asp-action="ChangeRole" asp-route-id="@u.Id" asp-route-vaiTro="KhachHang" method="post">
                                                        <button type="submit" class="dropdown-item @(u.VaiTro == "KhachHang" ? "active" : "")">Khách hàng</button>
                                                    </form>
                                                </li>
                                            </ul>

                                            <!-- Đặt lại mật khẩu button (kích hoạt modal) -->
                                            <button type="button" class="btn btn-outline-warning btn-sm" data-bs-toggle="modal" data-bs-target="#resetModal-@u.Id">
                                                Reset MK
                                            </button>
                                        </div>

                                        <!-- Modal Reset Password -->
                                        <div class="modal fade text-start" id="resetModal-@u.Id" tabindex="-1">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content">
                                                    <form asp-action="ResetPassword" asp-route-id="@u.Id" method="post">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title">Đặt lại mật khẩu: @u.TenDangNhap</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <label class="form-label fw-semibold">Mật khẩu mới</label>
                                                            <input type="password" name="matKhauMoi" class="form-control" placeholder="Tối thiểu 6 ký tự" required minlength="6" />
                                                            <small class="text-muted">Nhập mật khẩu mới sẽ gán trực tiếp cho tài khoản này.</small>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                                                            <button type="submit" class="btn btn-warning fw-semibold">Lưu Mật Khẩu</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">Không tìm thấy tài khoản nào phù hợp điều kiện lọc.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
