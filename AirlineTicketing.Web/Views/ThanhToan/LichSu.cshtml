@model IReadOnlyList<ThanhToanDTO>
@{
    ViewData["Title"] = "Lịch sử giao dịch & Hoàn tiền";
    var refunds = ViewBag.Refunds as IReadOnlyList<HoanTienDTO> ?? new List<HoanTienDTO>();
    var currentKeyword = ViewBag.CurrentKeyword as string;
    var currentTrangThai = ViewBag.CurrentTrangThai as TrangThaiThanhToan?;
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold mb-0 text-dark">Lịch Sử Giao Dịch & Sổ Cái Hoàn Tiền</h2>
            <small class="text-muted">Theo dõi toàn bộ các lần thu tiền, trạng thái giao dịch và thao tác hoàn tiền cho khách</small>
        </div>
        <div>
            <a asp-controller="BaoCao" asp-action="Index" class="btn btn-primary btn-sm">
                Xem Báo Cáo Doanh Thu
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Tabs Giao Dịch / Hoàn Tiền -->
    <ul class="nav nav-pills mb-3" id="pills-tab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-semibold" id="pills-payments-tab" data-bs-toggle="pill" data-bs-target="#pills-payments" type="button" role="tab">
                💳 Giao Dịch Thanh Toán (@Model.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-semibold text-danger" id="pills-refunds-tab" data-bs-toggle="pill" data-bs-target="#pills-refunds" type="button" role="tab">
                💸 Sổ Cái Hoàn Tiền (@refunds.Count)
            </button>
        </li>
    </ul>

    <div class="tab-content" id="pills-tabContent">
        <!-- Tab 1: Danh sách thanh toán -->
        <div class="tab-pane fade show active" id="pills-payments" role="tabpanel">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-3">
                    <form method="get" class="row g-2 align-items-center">
                        <div class="col-md-5">
                            <input type="text" name="keyword" value="@currentKeyword" class="form-control form-control-sm" placeholder="Tìm theo mã GD, mã đặt chỗ, nhà cung cấp..." />
                        </div>
                        <div class="col-md-3">
                            <select name="trangThai" class="form-select form-select-sm">
                                <option value="">-- Tất cả trạng thái --</option>
                                <option value="@TrangThaiThanhToan.ThanhCong" selected="@(currentTrangThai == TrangThaiThanhToan.ThanhCong)">Thành công</option>
                                <option value="@TrangThaiThanhToan.ChoXuLy" selected="@(currentTrangThai == TrangThaiThanhToan.ChoXuLy)">Chờ xử lý</option>
                                <option value="@TrangThaiThanhToan.ThatBai" selected="@(currentTrangThai == TrangThaiThanhToan.ThatBai)">Thất bại</option>
                            </select>
                        </div>
                        <div class="col-md-4 text-end">
                            <button type="submit" class="btn btn-sm btn-primary">Lọc Giao Dịch</button>
                            <a asp-action="LichSu" class="btn btn-sm btn-outline-secondary">Xóa lọc</a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Mã Giao Dịch</th>
                                    <th>Mã Đặt Vé</th>
                                    <th>Phương Thức / Cổng</th>
                                    <th class="text-end">Số Tiền</th>
                                    <th>Trạng Thái</th>
                                    <th>Ngày Tạo</th>
                                    <th class="text-end">Thao Tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Any())
                                {
                                    foreach (var p in Model)
                                    {
                                        <tr>
                                            <td class="fw-semibold"><code>@p.MaGiaoDich</code></td>
                                            <td>
                                                <a asp-action="Index" asp-route-datVeId="@p.DatVeId" class="badge bg-light text-primary border text-decoration-none">
                                                    @p.MaDatVe
                                                </a>
                                            </td>
                                            <td>@p.PhuongThuc (@p.NhaCungCap)</td>
                                            <td class="text-end fw-bold text-success">@p.SoTien.ToString("N0") @p.DonViTienTe</td>
                                            <td>
                                                @if (p.TrangThai == "ThanhCong")
                                                {
                                                    <span class="badge bg-success">Thành công</span>
                                                }
                                                else if (p.TrangThai == "ChoXuLy")
                                                {
                                                    <span class="badge bg-warning text-dark">Chờ xử lý</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Thất bại</span>
                                                }
                                            </td>
                                            <td class="small text-muted">@p.NgayTao.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                            <td class="text-end">
                                                <div class="btn-group btn-group-sm">
                                                    <a asp-action="KetQua" asp-route-id="@p.Id" class="btn btn-outline-info" title="Xem hóa đơn">
                                                        Hóa đơn
                                                    </a>
                                                    @if (p.TrangThai == "ThanhCong")
                                                    {
                                                        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#refundModal-@p.Id">
                                                            Hoàn tiền
                                                        </button>
                                                    }
                                                </div>

                                                @if (p.TrangThai == "ThanhCong")
                                                {
                                                    <!-- Modal Hoàn Tiền -->
                                                    <div class="modal fade text-start" id="refundModal-@p.Id" tabindex="-1">
                                                        <div class="modal-dialog modal-dialog-centered">
                                                            <div class="modal-content">
                                                                <form asp-action="HoanTien" method="post">
                                                                    <input type="hidden" name="ThanhToanId" value="@p.Id" />
                                                                    <div class="modal-header">
                                                                        <h5 class="modal-title text-danger">Tạo Giao Dịch Hoàn Tiền</h5>
                                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                                    </div>
                                                                    <div class="modal-body">
                                                                        <div class="mb-2">Giao dịch gốc: <code>@p.MaGiaoDich</code></div>
                                                                        <div class="mb-3">Số tiền gốc: <strong class="text-success">@p.SoTien.ToString("N0") @p.DonViTienTe</strong></div>

                                                                        <div class="mb-3">
                                                                            <label class="form-label fw-semibold">Số tiền hoàn (@p.DonViTienTe)</label>
                                                                            <input type="number" step="1000" max="@p.SoTien" min="1" name="SoTien" value="@p.SoTien" class="form-control" required />
                                                                            <small class="text-muted">Hỗ trợ hoàn toàn phần hoặc hoàn một phần.</small>
                                                                        </div>

                                                                        <div class="mb-3">
                                                                            <label class="form-label fw-semibold">Lý do hoàn tiền</label>
                                                                            <textarea name="LyDo" class="form-control" rows="2" placeholder="Ví dụ: Khách hủy vé, hoãn chuyến..." required></textarea>
                                                                        </div>
                                                                    </div>
                                                                    <div class="modal-footer">
                                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                                                                        <button type="submit" class="btn btn-danger fw-semibold">Xác Nhận Hoàn Tiền</button>
                                                                    </div>
                                                                </form>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center text-muted py-4">Không tìm thấy giao dịch nào.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tab 2: Sổ cái hoàn tiền -->
        <div class="tab-pane fade" id="pills-refunds" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Mã Hoàn Tiền</th>
                                    <th>Mã GD Gốc (FK)</th>
                                    <th>Cổng</th>
                                    <th class="text-end">Số Tiền Đã Hoàn</th>
                                    <th>Lý Do Hoàn</th>
                                    <th>Thời Gian</th>
                                    <th>Trạng Thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (refunds.Any())
                                {
                                    foreach (var r in refunds)
                                    {
                                        <tr>
                                            <td class="fw-semibold text-danger"><code>@r.MaGiaoDich</code></td>
                                            <td>#@r.ThanhToanId</td>
                                            <td>NoiBo</td>
                                            <td class="text-end fw-bold text-danger">-@r.SoTien.ToString("N0") @r.DonViTienTe</td>
                                            <td class="small">@r.LyDo</td>
                                            <td class="small text-muted">@r.NgayTao.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                            <td><span class="badge bg-success">Thành công</span></td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center text-muted py-4">Chưa có giao dịch hoàn tiền nào được ghi nhận.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
