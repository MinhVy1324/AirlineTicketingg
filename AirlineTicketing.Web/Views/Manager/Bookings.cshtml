@model BookingAdminViewModel
@using AirlineTicketing.Web.Infrastructure
@{
    ViewData["Title"] = "Quản lý khách hàng, đặt chỗ và vé";
}

<div class="av-page av-container">
    <header class="booking-title">
        <h1 class="av-page-title">Khách hàng, đặt chỗ và vé</h1>
        <p class="av-page-subtitle">Dữ liệu được đọc trực tiếp từ hệ thống đặt vé.</p>
    </header>

    <section class="av-card"><div class="av-card__body">
        <form method="get" class="lookup-form">
            <label class="av-field">
                <span class="av-label">Mã đặt chỗ, mã vé, tên hoặc email</span>
                <input name="q" value="@Model.TuKhoa" autocomplete="off" />
            </label>
            <button type="submit" class="av-btn av-btn--primary">Tìm kiếm</button>
        </form>
    </div></section>

    @if (Model.DatVes.Count == 0)
    {
        <div class="av-alert av-alert--info">Không có đặt chỗ phù hợp.</div>
    }
    else
    {
        @foreach (var booking in Model.DatVes)
        {
            <section class="av-card"><div class="av-card__body av-stack av-gap-12">
                <div class="av-row av-row--between av-wrap">
                    <h2 class="av-card__title">@booking.MaDatVe · @booking.TrangThai</h2>
                    <strong>@Money.Vnd(booking.TongTien)</strong>
                </div>
                <p>@booking.KhachHang.HoTen · @booking.KhachHang.Email · @booking.KhachHang.SoDienThoai</p>
                <p class="av-caption">Đặt lúc @booking.NgayDat.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · Hạn giữ @booking.HetHanGiuCho.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                @foreach (var ticket in booking.Ves)
                {
                    <div class="av-rowline">
                        <span>@ticket.MaVe · @ticket.HanhKhach.HoTen · @ticket.SoHieuChuyenBay · ghế @ticket.SoGhe</span>
                        <strong>@ticket.TrangThai · @Money.Vnd(ticket.GiaVe)</strong>
                    </div>
                }
            </div></section>
        }
    }
</div>
