    <section class="av-card admin-card">
        <div class="av-card__body admin-card__body">
            <div class="admin-card__head-main">
                <h2 class="av-card__title">@Model.ListTitle</h2>
                <span class="av-caption">@Model.ListSubtitle</span>
            </div>

            <div class="admin-table">
                <table class="av-table manager-table--schedules">
                    <thead>
                        <tr>
                            <th scope="col">@T("Chuyến / Tàu bay", "Flight / Aircraft")</th>
                            <th scope="col">@T("Tuyến", "Route")</th>
                            <th scope="col">@T("Giờ bay", "Flight time")</th>
                            <th scope="col">@T("Trạng thái", "Status")</th>
                            <th scope="col">@T("Ghế / Bán / Giữ / Trống", "Seats / Sold / Held / Available")</th>
                            <th scope="col">@T("Giá cơ bản từ", "Base fare from")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            <tr class="@(row.IsSelected ? "is-selected" : null)">
                                <td class="manager-flight-name">@row.Flight</td>
                                <td>@row.Route</td>
                                <td>@row.Time</td>
                                <td class="admin-table__result admin-table__result--@row.StatusTone">@ManagerSchedulesViewModel.StatusLabel(row.StatusText)</td>
                                <td>@row.Seats</td>
                                <td>@row.Price</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="av-pagination">
                <span>@Model.ResultText</span>
                <span class="av-pagination__links">
                    <a href="/quan-ly/lich-bay">@T("Trước", "Previous")</a>
                    <span class="is-current">1</span>
                    <a href="/quan-ly/lich-bay">@T("Sau", "Next")</a>
                </span>
            </div>
        </div>
    </section>

