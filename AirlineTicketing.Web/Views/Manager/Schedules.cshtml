                <div class="admin-table manager-fares" role="region" aria-label="@T("Hạng vé và tồn chỗ", "Cabin and availability")" tabindex="0">
                    <table class="av-table">
                        <thead>
                            <tr>
                                <th scope="col">@T("Hạng ghế", "Cabin")</th>
                                <th scope="col">@T("Sức chứa", "Capacity")</th>
                                <th scope="col">@T("Đã bán", "Sold")</th>
                                <th scope="col">@T("Cơ bản / khách", "Base fare / passenger")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var fare in Model.Fares)
                            {
                                <tr>
                                    <td class="manager-flight-name">@fare.Cabin</td>
