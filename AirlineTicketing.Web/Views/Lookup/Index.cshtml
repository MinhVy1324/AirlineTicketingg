    }
    else if (Model.ErrorMessage is null)
    {
        <div class="av-alert av-alert--info">
            <span class="av-alert__icon">@Html.Icon("info", 20)</span>
            <div class="av-alert__body">
                <span class="av-alert__title">@T("Chưa có thông tin tra cứu", "Find your booking details")</span>
                <span>@T("Nhập mã đặt chỗ và email liên hệ để xem chi tiết đặt chỗ của bạn.", "Enter your booking reference and contact email to see the booking details.")</span>
            </div>
        </div>
    }
</div>
