@model LookupPageViewModel
@{
    ViewData["Title"] = T("Tra cứu đặt chỗ", "Find a booking");
    ViewData["CompactNav"] = true;
    var result = Model.Result;
}

<div class="av-page av-container">
    <header class="booking-title">
        <h1 class="av-page-title">@T("Tra cứu đặt chỗ", "Find a booking")</h1>
        <p class="av-page-subtitle">
            @T("Nhập mã đặt chỗ (PNR) và email liên hệ đã dùng khi đặt vé. Không cần đăng nhập.", "Enter your booking reference (PNR) and the contact email you used. You can look up your booking without signing in.")
        </p>
    </header>

    <section class="av-card">
        <div class="av-card__body av-stack av-gap-18">
            <h2 class="av-card__title">@T("Thông tin tra cứu", "Booking lookup details")</h2>

            <form class="lookup-form" method="post" action="/tra-cuu">
                @Html.AntiForgeryToken()

                <label class="av-field">
                    <span class="av-label">@T("Mã đặt chỗ (PNR)", "Booking reference (PNR)") <span class="req">*</span></span>
                    <span class="av-control @(Model.ErrorMessage is not null ? "is-invalid" : null)">
                        <input type="text" name="Pnr" value="@Model.Form.Pnr" autocomplete="off" required />
                        @Html.Icon("ticket", 17)
                    </span>
                </label>

                <label class="av-field">
                    <span class="av-label">@T("Email liên hệ", "Contact email") <span class="req">*</span></span>
                    <span class="av-control @(Model.ErrorMessage is not null ? "is-invalid" : null)">
                        <input type="email" name="Email" value="@Model.Form.Email" autocomplete="email" required />
                        @Html.Icon("mail", 17)
                    </span>
                </label>

                <button type="submit" class="av-btn av-btn--primary">@T("Tra cứu đặt chỗ", "Find a booking")</button>
            </form>

            <p class="av-micro">
                @T("Chỉ hiển thị đặt chỗ khi mã PNR và email liên hệ khớp. Nếu không khớp, hệ thống không cung cấp thông tin đặt chỗ; vui lòng kiểm tra lại cả hai trường.",
                    "The booking reference and contact email must both match. Check both fields if you cannot find your booking.")
            </p>
        </div>
    </section>

    @if (Model.ErrorMessage is not null)
    {
        <div class="av-alert av-alert--danger">
            <span class="av-alert__icon">@Html.Icon("alert", 20)</span>
            <div class="av-alert__body">
                <span class="av-alert__title">@T("Không thể tra cứu đặt chỗ", "Booking lookup failed")</span>
                <span>@Model.ErrorMessage</span>
            </div>
        </div>
    }

    @if (Model.HasResult && result is not null)
    {
        <div class="av-alert av-alert--success">
            <span class="av-alert__icon">@Html.Icon("check-circle", 20)</span>
            <div class="av-alert__body">
                <span class="av-alert__title">@T("Đã tìm thấy đặt chỗ khớp thông tin tra cứu", "Booking found")</span>
                <span>
                    @T($"PNR {result.Pnr} · Email liên hệ đã xác nhận. Một phần thông tin cá nhân được ẩn để bảo vệ hành khách.", $"PNR {result.Pnr} · Contact email verified. Some personal information is masked for passenger privacy.")
                </span>
            </div>
        </div>

        <div class="booking-layout">
            <div class="booking-main">
                <section class="av-card">
                    <div class="av-card__body av-stack av-gap-16">
                        <h2 class="av-card__title">@T("Chi tiết đặt chỗ", "Booking details") · @result.Pnr</h2>

                        <div class="av-row av-gap-8 av-wrap">
