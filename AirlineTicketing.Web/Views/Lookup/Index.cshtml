                        </div>

                        <partial name="_JourneyBlock" model="result.Flight" />
                        <div class="av-rows">
                            <h3>@T("Tất cả hành khách / chặng bay", "All passengers and flights")</h3>
                            @foreach (var row in result.JourneyRows) { <p>@row</p> }
                        </div>

                        <hr class="av-divider" />

                        <div class="av-rows">
                            <div class="av-rowline">
                                <span class="av-rowline__label">@T("Hành khách", "Passenger")</span>
                                <span class="av-rowline__value">@result.PassengerMasked</span>
                            </div>
                            <div class="av-rowline">
                                <span class="av-rowline__label">@T("Giấy tờ", "Travel document")</span>
                                <span class="av-rowline__value">@result.IdentityMasked</span>
                            </div>
                            <div class="av-rowline">
                                <span class="av-rowline__label">@T("Số điện thoại", "Phone number")</span>
                                <span class="av-rowline__value">@result.PhoneMasked</span>
                            </div>
                            <div class="av-rowline">
                                <span class="av-rowline__label">@T("Email liên hệ", "Contact email")</span>
                                <span class="av-rowline__value">@result.EmailMasked</span>
                            </div>
                            <div class="av-rowline">
                                <span class="av-rowline__label">@T("Ghế / hành lý", "Seat and baggage")</span>
                                <span class="av-rowline__value">@result.SeatCode · @result.BaggageText</span>
                            </div>
                            <div class="av-rowline">
                                <span class="av-rowline__label">@T("Số vé", "Ticket number")</span>
                                <span class="av-rowline__value av-num">@result.TicketNumber</span>
                            </div>
                            <div class="av-rowline av-rowline--total">
                                <span class="av-rowline__label">@T("Tổng đã thanh toán", "Total paid")</span>
                                <span class="av-rowline__value">@Money.Vnd(result.Total)</span>
                            </div>
                            <div class="av-rowline">
                                <span class="av-rowline__label">@T("Ngày đặt", "Booked on")</span>
                                <span class="av-rowline__value">@result.BookedAtText</span>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="av-card">
                    <div class="av-card__body av-stack av-gap-16">
                        <h2 class="av-card__title">@T("Quản lý đặt chỗ", "Manage your booking")</h2>

                        <div class="av-row av-gap-12 av-wrap">
