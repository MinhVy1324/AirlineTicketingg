        <div class="search-card__types">
            <div class="av-toggle">
                <label class="av-toggle__item @(Model.Search.Trip == "oneway" ? "is-active" : null)">
                    <input type="radio" name="trip" value="oneway" checked="@(Model.Search.Trip == "oneway")" />
                    <span>@T("Một chiều", "One-way")</span>
                </label>
                <label class="av-toggle__item @(Model.Search.Trip == "roundtrip" ? "is-active" : null)">
                    <input type="radio" name="trip" value="roundtrip" checked="@(Model.Search.Trip == "roundtrip")" />
                    <span>@T("Khứ hồi", "Round trip")</span>
                </label>
            </div>
        </div>

        <div class="search-grid search-grid--route">
            <label class="av-field">
                <span class="av-label">@T("Nơi đi", "From")</span>
                <span class="av-control">
                    <input type="text" name="from" value="@Model.Search.From" autocomplete="off" />
                    @Html.Icon("plane-takeoff", 17)
                </span>
            </label>

            <label class="av-field">
                <span class="av-label">@T("Nơi đến", "To")</span>
                <span class="av-control">
                    <input type="text" name="to" value="@Model.Search.To" autocomplete="off" />
                    @Html.Icon("plane-landing", 17)
                </span>
            </label>

            <label class="av-field">
                <span class="av-label">@T("Ngày đi", "Departure date")</span>
                <span class="av-control">
                    <input type="date" name="depart" value="@(FlightMapping.TryParseDate(Model.Search.DepartDate, out var departDay) ? departDay.ToString("yyyy-MM-dd") : "")" required />
                </span>
            </label>

            <label class="av-field">
                <span class="av-label">@T("Ngày về", "Return date")</span>
                <span class="av-control">
                    <input type="date" name="returnDate" value="@(FlightMapping.TryParseDate(Model.Search.ReturnDate, out var returnDay) ? returnDay.ToString("yyyy-MM-dd") : "")" data-return-date />
                </span>
            </label>
        </div>

        <div class="search-grid search-grid--who">
            <div class="search-party-fields">
                <label class="av-field"><span class="av-label">@T("Người lớn ≥12", "Adults ≥12")</span><span class="av-control"><input type="number" name="adults" value="@Model.Search.Adults" min="1" max="9" required /></span></label>
                <label class="av-field"><span class="av-label">@T("Trẻ em 2–<12", "Children 2–<12")</span><span class="av-control"><input type="number" name="children" value="@Model.Search.Children" min="0" max="8" required /></span></label>
                <label class="av-field"><span class="av-label">@T("Em bé <2", "Infants <2")</span><span class="av-control"><input type="number" name="infants" value="@Model.Search.Infants" min="0" max="9" required /></span></label>
            </div>

            <label class="av-field">
                <span class="av-label">@T("Hạng vé", "Cabin")</span>
                <span class="av-control">
                    <select name="cabin">
                        @foreach (var fare in JourneyRules.Cabins)
                        {
                            <option value="@fare.Code" selected="@(JourneyBookingBuilder.CabinOf(Model.Search.Cabin).Code == fare.Code)">@UiLanguage.Label(fare.Name)</option>
                        }
                    </select>
                    @Html.Icon("chevron-down", 17)
                </span>
            </label>

            <p class="search-grid__note">
                <span>@T("Giờ bay theo giờ địa phương.", "Flight times are local.")</span>
            </p>

            <button type="submit" class="av-btn av-btn--primary search-submit">
                @Html.Icon("search", 17)
                <span>@T("Tìm chuyến bay", "Find flights")</span>
            </button>
        </div>
    </form>
