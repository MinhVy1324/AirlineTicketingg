@model IReadOnlyList<BookingStatusItem>
<div class="status-grid">
    @foreach (var item in Model)
    {
        <div class="status-card">
            <span class="status-card__label">@BookingUiText.Text(item.Label)</span>
            <span class="status-card__value">@BookingUiText.Text(item.Value)</span>
        </div>
    }
</div>
