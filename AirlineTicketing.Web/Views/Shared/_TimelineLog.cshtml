@model BookingOutcomeViewModel
<section class="av-card">
    <div class="av-card__body av-card__stack">
        <div class="av-stack av-gap-6">
            <h2 class="av-card__title">@BookingUiText.Text(Model.EventsTitle)</h2>
            @if (!string.IsNullOrWhiteSpace(Model.EventsSubtitle))
            {
                <span class="av-caption">@BookingUiText.Text(Model.EventsSubtitle)</span>
            }
        </div>

        <div class="timeline-log">
            @foreach (var item in Model.Events)
            {
                <div class="timeline-log__item">
                    <span class="timeline-log__time">@BookingUiText.DateTimeText(item.Time)</span>
                    <div class="timeline-log__body">
                        <span class="timeline-log__title">@BookingUiText.Text(item.Title)</span>
                        <span class="timeline-log__text">@BookingUiText.Text(item.Text)</span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
