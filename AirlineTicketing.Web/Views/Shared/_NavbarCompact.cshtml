@{
    var nav = ViewData["Nav"] as string ?? "lookup";
    string Active(string key) => nav == key ? "is-active" : string.Empty;
}
<header class="av-nav">
    <div class="av-container av-nav__inner">
        <a class="av-brand" href="/" aria-label="@T("AeroViet · Trang chủ", "AeroViet · Home")">
            <span class="av-brand__mark">@Html.Icon("plane", 23)</span>
            <span class="av-brand__name">AeroViet</span>
        </a>

        <nav class="av-nav__menu" aria-label="@T("Điều hướng chính", "Main navigation")">
            <a class="av-nav__link @Active("book")" href="/" aria-current="@(nav == "book" ? "page" : null)">@T("Đặt vé", "Book")</a>
            <a class="av-nav__link @Active("lookup")" href="/tra-cuu" aria-current="@(nav == "lookup" ? "page" : null)">@T("Tra cứu đặt chỗ", "Look up a booking")</a>
            <a class="av-nav__link @Active("offers")" href="/khuyen-mai">@T("Ưu đãi", "Offers")</a>
            <a class="av-nav__link @Active("about")" asp-controller="Home" asp-action="About" aria-current="@(nav == "about" ? "page" : null)">@T("Giới thiệu", "About")</a>
            <a class="av-nav__link" asp-controller="Home" asp-action="About" asp-fragment="ho-tro">@T("Trợ giúp", "Help")</a>
        </nav>

