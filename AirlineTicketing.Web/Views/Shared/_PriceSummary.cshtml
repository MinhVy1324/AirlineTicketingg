@model PriceSummary
<section class="av-card">
    <div class="av-card__body av-card__stack">
        <h2 class="av-card__title">@BookingUiText.Text(Model.Title)</h2>

        <div class="price-lines">
            <div class="av-rowline">
                <span class="av-rowline__label">@BookingUiText.Text(Model.BaseFareLabel)</span>
                <span class="av-rowline__value">@Money.Vnd(Model.BaseFare)</span>
            </div>
            <div class="av-rowline">
                <span class="av-rowline__label">@T("Thuế & phí sân bay", "Taxes & airport fees")</span>
                <span class="av-rowline__value">@Money.Vnd(Model.Taxes)</span>
            </div>
            <div class="av-rowline">
                <span class="av-rowline__label">@T("Phí dịch vụ", "Service fee")</span>
                <span class="av-rowline__value">@Money.Vnd(Model.ServiceFee)</span>
            </div>
