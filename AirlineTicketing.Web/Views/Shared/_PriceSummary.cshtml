>>>>>>> Stashed changes
            @if (Model.BaggageFee > 0)
            {
                <div class="av-rowline">
                    <span class="av-rowline__label">@BookingUiText.Text(Model.BaggageLabel)</span>
                    <span class="av-rowline__value">@Money.Vnd(Model.BaggageFee)</span>
                </div>
            }
            @if (Model.Discount > 0)
            {
                <div class="av-rowline">
                    <span class="av-rowline__label">@T("Ưu đãi", "Promotion") @Model.PromotionCode</span>
                    <span class="av-rowline__value">−@Money.Vnd(Model.Discount)</span>
                </div>
            }
        </div>

        <hr class="av-divider" />

        @if (Model.ChangeFeePaid > 0)
        {
            <div class="av-rowline">
                <span class="av-rowline__label">@T("Phí đổi vé đã thu", "Change fees already paid")</span>
                <span class="av-rowline__value av-num">@Money.Vnd(Model.ChangeFeePaid)</span>
            </div>
        }
        <div class="av-rowline av-rowline--total">
            <span class="av-rowline__label">@BookingUiText.Text(Model.TotalLabel)</span>
            <span class="av-rowline__value av-num">@Money.Vnd(Model.Total)</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Note))
        {
            <p class="av-caption">@BookingUiText.Text(Model.Note)</p>
        }
    </div>
</section>
