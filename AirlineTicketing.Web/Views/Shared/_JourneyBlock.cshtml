@model FlightOffer
<div class="summary-flight">
    <div class="summary-flight__airline">
        <span class="summary-flight__airline-name">
            @Html.Icon("plane", 20)
            @Model.AirlineName
        </span>
        <span class="av-badge av-badge--info">@Model.FlightNumber</span>
    </div>

    <span class="summary-flight__date">@BookingUiText.LongDate(Model.Departure) · @BookingUiText.Text(Model.Stops)</span>

    <partial name="_FlightTimeline" model="new FlightTimelineModel(Model, ShowAirportName: true)" />

    <hr class="av-divider" />
    <span class="av-caption">@BookingUiText.Text(Model.FareName) · @T("1 người lớn", "1 adult")</span>
</div>
