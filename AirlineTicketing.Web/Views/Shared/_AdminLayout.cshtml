@{
    var activeNav = ViewData["AdminNav"] as string ?? "overview";
    var crumb = AdminNav.LabelFor(activeNav);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · AeroViet Admin</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="admin-body">
    <input type="checkbox" id="admin-nav-toggle" class="admin-nav-toggle" aria-hidden="true" tabindex="-1" />

    <div class="admin-shell">
        <label for="admin-nav-toggle" class="admin-scrim" aria-hidden="true"></label>

        <aside class="admin-side" aria-label="Quản trị hệ thống">
            <div class="admin-side__top">
                <a class="admin-brand" href="/admin">
                    <span class="admin-brand__mark">@Html.Icon("plane", 20)</span>
                    <span class="admin-brand__text">
                        <strong>AeroViet</strong>
                        <span>Quản trị hệ thống</span>
                    </span>
                </a>

                <label for="admin-nav-toggle" class="admin-side__close" aria-label="Đóng điều hướng">
                    @Html.Icon("x", 18)
                </label>
            </div>

            <nav class="admin-nav" aria-label="Mục quản trị">
                @foreach (var item in AdminNav.Items)
                {
                    var isActive = activeNav == item.Key;
                    <a class="admin-nav__item @(isActive ? "is-active" : null)"
                       href="@item.Href"
                       aria-current="@(isActive ? "page" : null)">
                        <span class="admin-nav__icon">@Html.Icon(item.Icon, 18)</span>
                        <span>@item.Label</span>
                    </a>
                }
            </nav>

            <p class="admin-side__foot">
                Phiên bản 1.0 · Dữ liệu theo hệ thống.<br />
                Quyền truy cập theo vai trò được cấp.
            </p>
        </aside>

        <div class="admin-main">
            <header class="admin-topbar">
                <label for="admin-nav-toggle" class="admin-topbar__menu" aria-label="Mở điều hướng">
                    @Html.Icon("menu", 20)
                </label>

                <nav class="admin-crumb" aria-label="Đường dẫn">
                    <a href="/admin">Admin</a>
                    <span class="admin-crumb__sep" aria-hidden="true">/</span>
                    <span class="admin-crumb__current">@crumb</span>
                </nav>

                <span class="admin-topbar__sep" aria-hidden="true"></span>

                <p class="admin-topbar__note">
                    @Html.Icon("clock", 16)
                    <span>Giờ hệ thống (UTC+7)</span>
                </p>

                <span class="admin-pill admin-pill--ok">
                    <span class="admin-dot" aria-hidden="true"></span>
                    Hoạt động
                </span>

                <div class="admin-topbar__user" title="@User.DisplayName()">
                    <span class="admin-avatar">@User.Initials()</span>
                    <span class="admin-topbar__name">
                        <strong>@User.DisplayName()</strong>
                        <span>@(User.FindFirstValue(ClaimTypes.Role) == "Admin" ? "Quản trị viên" : "Nhân sự")</span>
                    </span>
                    <a class="av-link av-link--sm" href="/dang-xuat">Đăng xuất</a>
                </div>
            </header>

            <main class="admin-content">
                @RenderBody()
            </main>

            <footer class="admin-footer">
                <span>AeroViet · Hệ thống bán vé máy bay</span>
                <span>Dữ liệu hệ thống · Giờ Việt Nam (UTC+7)</span>
            </footer>
        </div>
    </div>

    <partial name="_InstanceBadge" />

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
