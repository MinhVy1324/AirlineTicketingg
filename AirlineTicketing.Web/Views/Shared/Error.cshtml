@model ErrorViewModel
@{
    ViewData["Title"] = T("Có lỗi xảy ra", "An error occurred");
}

<h1 class="text-danger">@ViewData["Title"]</h1>
<h2 class="text-danger">@T("Có lỗi khi xử lý yêu cầu của bạn.", "An error occurred while processing your request.")</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@T("Mã yêu cầu", "Request ID")</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>@T("Chế độ phát triển", "Development mode")</h3>
<p>
    @T("Môi trường Development hiển thị thông tin chi tiết hơn về lỗi.", "The Development environment displays more details about the error.")
</p>
<p>
    @T("Để gỡ lỗi trên máy cục bộ, đặt biến môi trường ASPNETCORE_ENVIRONMENT thành Development rồi khởi động lại ứng dụng.",
        "For local debugging, set ASPNETCORE_ENVIRONMENT to Development and restart the application.")
</p>
