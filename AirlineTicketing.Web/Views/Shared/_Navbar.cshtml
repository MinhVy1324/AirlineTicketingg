@{
    var nav = ViewData["Nav"] as string ?? "book";
    string Active(string key) => nav == key ? "is-active" : string.Empty;
    var fullName = User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value
        ?? User.Identity?.Name ?? "Tài khoản";
    var initials = string.Join("", fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .TakeLast(2).Select(part => char.ToUpperInvariant(part[0])));
}
<header class="av-nav">
    <div class="av-container av-nav__inner">
        <a class="av-brand" href="/" aria-label="AeroViet · Trang chủ">
            <span class="av-brand__mark">@Html.Icon("plane", 23)</span>
            <span class="av-brand__name">AeroViet</span>
        </a>

        <nav class="av-nav__menu" aria-label="Điều hướng chính">
            <a class="av-nav__link @Active("book")" href="/" aria-current="@(nav == "book" ? "page" : null)">Đặt vé</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="av-nav__link @Active("tickets")" href="/ve-cua-toi">Vé của tôi</a>
                <a class="av-nav__link" href="/ThanhToan/ChoThanhToan">Thanh toán</a>
            }
            <a class="av-nav__link @Active("offers")" href="/#uu-dai">Ưu đãi</a>
            <a class="av-nav__link @Active("help")" href="/#tro-giup">Trợ giúp</a>
            @if (User.IsInRole("Admin") || User.IsInRole("NhanVien"))
            {
                <a class="av-nav__link" href="/Dashboard">Dashboard</a>
                <a class="av-nav__link" href="/BaoCao">Báo cáo</a>
                <a class="av-nav__link" href="/ThanhToan/LichSu">Thanh toán</a>
            }
            @if (User.IsInRole("Admin"))
            {
                <a class="av-nav__link" href="/QuanLyTaiKhoan">Tài khoản</a>
            }
        </nav>

        <div class="av-nav__aside">
            <span class="av-nav__locale">
                @Html.Icon("globe", 17)
                <span>VI · VND</span>
            </span>
            <span class="av-nav__sep" aria-hidden="true"></span>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="av-nav__user" asp-controller="Account" asp-action="Profile" aria-label="Hồ sơ của @fullName">
                    <span class="av-avatar">@initials</span>
                    <span>@fullName</span>
                    @Html.Icon("chevron-down", 14)
                </a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <button class="av-link" type="submit">Đăng xuất</button>
                </form>
            }
            else
            {
                <a class="av-link" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                <a class="av-btn av-btn--primary" asp-controller="Account" asp-action="Register">Đăng ký</a>
            }
        </div>
    </div>
</header>
