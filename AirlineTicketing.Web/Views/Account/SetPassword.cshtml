@model AccountFormViewModel
@{
    ViewData["Title"] = T("Đặt lại mật khẩu", "Reset your password");
}
<div class="av-page av-container">
    <section class="av-card account-form">
        <div class="av-card__body av-card__stack">
            <h1 class="av-page-title">@ViewData["Title"]</h1>
            @if (Model.InvalidLink)
            {
                <p class="auth__error" role="alert">@T("Liên kết không hợp lệ, đã sử dụng hoặc đã hết hạn.", "The link is invalid, already used, or expired.")</p>
                <a class="av-link" href="/quen-mat-khau">@T("Yêu cầu liên kết mới", "Request a new link")</a>
            }
            else
            {
                <p>@T("Email đã xác nhận:", "Verified email") <strong>@Model.Email</strong></p>
                <form method="post" action="/dat-lai-mat-khau" class="av-stack av-gap-16">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Token" value="@Model.Token" />
                    @if (Model.Error is { } error) { <p class="auth__error" role="alert">@error</p> }
                    <label class="av-field"><span class="av-label">@T("Mật khẩu mới", "New password")</span><span class="av-control"><input type="password" name="Password" minlength="12" maxlength="128" autocomplete="new-password" required /></span></label>
                    <label class="av-field"><span class="av-label">@T("Nhập lại mật khẩu", "Confirm password")</span><span class="av-control"><input type="password" name="ConfirmPassword" maxlength="128" autocomplete="new-password" required /></span></label>
                    <p class="av-caption">@T("Dùng mật khẩu từ 12 đến 128 ký tự.", "Use a password between 12 and 128 characters.")</p>
                    <button type="submit" class="av-btn av-btn--primary">@T("Lưu mật khẩu mới", "Save new password")</button>
                </form>
            }
            <a class="av-link" href="/dang-nhap">@T("Quay lại đăng nhập", "Back to sign in")</a>
        </div>
    </section>
</div>
