@{
    ViewData["Title"] = "Từ chối truy cập";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card border-0 shadow-sm p-4">
            <div class="card-body">
                <div class="text-danger mb-3" style="font-size: 4rem;">
                    &#9888;
                </div>
                <h3 class="fw-bold text-danger">Không có quyền truy cập (403)</h3>
                <p class="text-muted mt-3">
                    Tài khoản của bạn không có đủ thẩm quyền để truy cập vào tài nguyên hoặc chức năng này.
                    Vui lòng liên hệ với Quản trị viên nếu bạn cho rằng đây là một sự nhầm lẫn.
                </p>
                <div class="mt-4">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4">Về Trang Chủ</a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary px-4 ms-2">Đăng Nhập Lại</a>
                </div>
            </div>
        </div>
    </div>
</div>
