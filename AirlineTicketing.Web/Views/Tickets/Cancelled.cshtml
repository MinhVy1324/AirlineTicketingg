@model CancelledFlightViewModel
@{
    ViewData["Title"] = "Chuyến bay bị hủy";
    ViewData["Nav"] = "tickets";
    var booking = Model.Booking;
    var flight = booking.Flight;
}

<div class="av-page av-container">
    <header class="booking-title">
        <h1 class="av-page-title">Chuyến bay bị hủy</h1>
        <p class="av-page-subtitle">Vé của tôi / @booking.Pnr · Thông báo từ @flight.AirlineName</p>
    </header>

    <div class="av-alert av-alert--danger">
        <span class="av-alert__icon">@Html.Icon("alert", 20)</span>
        <div class="av-alert__body">
            <span class="av-alert__title">
                @flight.AirlineName hủy chuyến @flight.FlightNumber ngày @Money.Date(flight.Departure)
            </span>
            <span>
                Hãng thông báo lúc 10:00 ngày 12/11/2026 do thay đổi kế hoạch khai thác.
                Chuyến bay không còn thực hiện theo lịch đã đặt. Vui lòng chọn phương án hỗ trợ bên dưới.
            </span>
        </div>
    </div>

    <div class="cancelled-layout">
        <aside class="av-card">
            <div class="av-card__body av-stack av-gap-16">
                <h2 class="av-card__title">Đặt chỗ · @booking.Pnr</h2>

                <partial name="_JourneyBlock" model="flight" />

                <span class="av-badge av-badge--danger">Chuyến bay bị hủy</span>

                <hr class="av-divider" />

                <div class="av-rows">
                    <div class="av-rowline">
                        <span class="av-rowline__label">Hành khách</span>
                        <span class="av-rowline__value">@booking.Passenger.FullName</span>
                    </div>
                    <div class="av-rowline">
                        <span class="av-rowline__label">Số vé</span>
                        <span class="av-rowline__value av-num">@Model.TicketNumber</span>
                    </div>
                    <div class="av-rowline av-rowline--total">
                        <span class="av-rowline__label">Tổng đã thanh toán</span>
                        <span class="av-rowline__value">@Model.PaidText</span>
                    </div>
                    <div class="av-rowline">
                        <span class="av-rowline__label">Thanh toán</span>
                        <span class="av-rowline__value">@Model.PaymentText</span>
                    </div>
                </div>

                <div class="av-alert av-alert--info">
                    <span class="av-alert__icon">@Html.Icon("headset", 20)</span>
                    <div class="av-alert__body">
                        <span class="av-alert__title">Hỗ trợ đặt chỗ</span>
                        <span>1900 6868 · 06:00–22:00 · support@aeroviet.vn. Cung cấp mã PNR @booking.Pnr để được kiểm tra.</span>
                    </div>
                </div>
            </div>
        </aside>

        <div class="cancelled-options av-stack av-gap-20">
            <section class="av-card">
                <div class="av-card__body av-stack av-gap-12">
                    <h2 class="av-card__title">Yêu cầu chuyến thay thế</h2>
                    <p class="av-body">
                        Đề nghị hãng bố trí chuyến bay khác trên tuyến @flight.From.Code → @flight.To.Code.
                        Bạn có thể nêu ngày và khung giờ mong muốn để được kiểm tra chỗ.
                    </p>
                    <p class="av-caption">
                        Phương án chuyển chuyến miễn phí phụ thuộc thông báo hãng và tình trạng chỗ.
                        Bạn sẽ được xác nhận trước khi xuất lại vé.
                    </p>
                    <div>
                        <a class="av-btn av-btn--primary" href="/ve-cua-toi/yeu-cau-doi">Yêu cầu chuyến thay thế</a>
                    </div>
                </div>
            </section>

            <section class="av-card">
                <div class="av-card__body av-stack av-gap-12">
                    <h2 class="av-card__title">Yêu cầu hoàn do hãng hủy</h2>
                    <p class="av-body">
                        Nếu không tiếp tục hành trình, gửi yêu cầu hoàn theo chính sách áp dụng cho chuyến bị hãng hủy.
                    </p>
                    <p class="av-caption">
                        Không áp đặt phí hoàn tự nguyện @Money.Vnd(flight.RefundFee). Khoản được hoàn và thời gian nhận tiền
                        được xác nhận theo thông báo hãng, hoàn về nguồn thanh toán ban đầu.
                    </p>
                    <div>
                        <a class="av-btn av-btn--outline" href="/ve-cua-toi/yeu-cau-hoan">Yêu cầu hoàn do hãng hủy</a>
                    </div>
                </div>
            </section>

            <div class="av-alert av-alert--warning">
                <span class="av-alert__icon">@Html.Icon("alert", 20)</span>
                <div class="av-alert__body">
                    <span class="av-alert__title">Chưa tự động hoàn tiền</span>
                    <span>
                        Thông báo hủy chuyến không đồng nghĩa tiền đã được hoàn. Sau khi gửi yêu cầu, theo dõi trạng thái xử lý;
                        chỉ ghi nhận hoàn tất khi cổng thanh toán xác nhận.
                    </span>
                </div>
            </div>

            <p class="av-caption">
                Chưa gửi yêu cầu hỗ trợ cho đặt chỗ @booking.Pnr. Bạn chỉ cần chọn một phương án phù hợp.
            </p>
        </div>
    </div>
</div>
