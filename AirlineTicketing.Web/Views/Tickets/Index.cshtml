                    </div>

@if (detail.Journey is { } journey) { <partial name="_JourneySummary" model="journey" /> } else {
                    <div class="summary-flight">
                        <div class="summary-flight__airline">
                            <span class="summary-flight__airline-name">
                                @Html.Icon("plane", 20)
                                @detail.Flight.AirlineName
                            </span>
                            <span class="av-badge av-badge--info">@detail.Flight.FlightNumber</span>
                        </div>
                        <span class="summary-flight__date">@BookingUiText.LongDate(detail.Flight.Departure) · @BookingUiText.Text(detail.Flight.Stops)</span>

                        <partial name="_FlightTimeline" model="new FlightTimelineModel(detail.Flight, ShowAirportName: true)" />

                        <hr class="av-divider" />
                        <span class="av-caption">@UiLanguage.Label(detail.Flight.FareName) · @T("1 người lớn", "1 adult")</span>
                    </div>

                    <hr class="av-divider" />

                    <div class="av-rows">
                        <div class="av-rowline">
                            <span class="av-rowline__label">@T("Hành khách / ghế", "Passenger and seat")</span>
                            <span class="av-rowline__value">@detail.PassengerName · @detail.SeatCode</span>
                        </div>
                        <div class="av-rowline">
                            <span class="av-rowline__label">@T("Số vé", "Ticket number")</span>
                            <span class="av-rowline__value av-num">@detail.TicketNumber</span>
                        </div>
                        <div class="av-rowline">
                            <span class="av-rowline__label">@T("Hành lý", "Baggage")</span>
                            <span class="av-rowline__value">@detail.BaggageText</span>
                        </div>
</div>}<div class="av-rows">
