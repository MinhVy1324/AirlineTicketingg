@model TicketsViewModel
@{
    ViewData["Title"] = T("Vé của tôi", "My tickets");
    ViewData["Nav"] = "tickets";
    var detail = Model.Detail;
}

<div class="av-page av-container">
    @if (TempData["TicketMsg"] is string message)
    {
        <div class="av-alert av-alert--info" role="status">@message</div>
    }
    <header class="av-stack av-gap-6">
        <span class="av-eyebrow">@T("QUẢN LÝ HÀNH TRÌNH", "MANAGE YOUR TRIP")</span>
        <h1 class="av-page-title">@T("Vé của tôi", "My tickets")</h1>
        <p class="av-page-subtitle">@T("Xem thông tin đặt chỗ, vé điện tử và các yêu cầu hỗ trợ của bạn.", "View your bookings, e-tickets, and support requests.")</p>
    </header>

    <nav class="av-chips" aria-label="@T("Lọc đặt chỗ theo trạng thái", "Filter bookings by status")">
        @foreach (var tab in Model.Tabs)
        {
            <a class="av-chip @(tab.IsActive ? "is-active" : null)" href="@tab.Href"
               aria-current="@(tab.IsActive ? "page" : null)">@tab.Label (@tab.Count)</a>
        }
    </nav>

    <form class="tickets-toolbar" method="get" action="/ve-cua-toi" role="search">
        @if (Model.ActiveTab is not null)
        {
            <input type="hidden" name="tab" value="@Model.ActiveTab" />
        }
        <label class="av-field">
            <span class="av-label">@T("Tìm đặt chỗ", "Find a booking")</span>
            <span class="av-control">
                <input type="search" name="q" value="@Model.Search" placeholder="@T("Nhập mã PNR hoặc điểm đến", "Enter a booking reference or destination")" autocomplete="off" />
                @Html.Icon("search", 17)
            </span>
        </label>

        <label class="av-field av-field--date">
            <span class="av-label">@T("Ngày khởi hành", "Departure date")</span>
            <span class="av-control">
                <select name="date">
                    <option value="" selected="@(Model.DateFilter is null)">@T("Tất cả thời gian", "Any date")</option>
                    <option value="upcoming" selected="@(Model.DateFilter == "upcoming")">@T("Sắp tới", "Upcoming")</option>
                    <option value="past" selected="@(Model.DateFilter == "past")">@T("Đã qua", "Past")</option>
                </select>
                @Html.Icon("calendar", 17)
            </span>
        </label>

        <button type="submit" class="av-btn av-btn--primary">@T("Tìm kiếm", "Search")</button>
    </form>

    @if (Model.Search is not null || Model.DateFilter is not null)
    {
        <a class="av-link" asp-action="Index" asp-route-tab="@Model.ActiveTab">@T("Xóa bộ lọc", "Clear filters")</a>
    }

    @if (detail is null)
    {
        <p class="av-body">@T("Không có đặt chỗ phù hợp trong mục này.", "No matching bookings in this section.")</p>
        <a class="av-link" href="/ve-cua-toi/yeu-cau">@T("Theo dõi yêu cầu đổi/hoàn", "Track change and refund requests")</a>
    }
    else
    {
    <div class="tickets-layout">
        <section class="tickets-list" aria-label="@T("Danh sách đặt chỗ", "Booking list")">
            @foreach (var ticket in Model.Tickets)
            {
                <article class="pnr-card @(ticket.IsSelected ? "is-selected" : null)">
                    <div class="pnr-card__head">
                        <strong class="pnr-card__code">@ticket.Pnr</strong>
                        <span class="av-badge av-badge--@ticket.StatusTone">@ticket.StatusText</span>
                    </div>

                    <span class="pnr-card__route">@ticket.RouteText</span>
                    <span class="pnr-card__meta">@ticket.ScheduleText</span>

                    <hr class="av-divider" />

                    <div class="pnr-card__foot">
                        <span class="av-muted">@ticket.PassengerText</span>
                        <strong class="av-num">@ticket.PriceText</strong>
                    </div>

                    <span class="pnr-card__link @(ticket.NoteTone == "warning" ? "is-warning" : null)">
                        @ticket.NoteText
                    </span>

                    @if (!string.IsNullOrWhiteSpace(ticket.ActionText) && !string.IsNullOrWhiteSpace(ticket.ActionHref))
                    {
                        <a class="av-btn av-btn--outline av-btn--sm pnr-card__action" href="@ticket.ActionHref"
                           aria-label="@ticket.ActionText @ticket.Pnr">
                            @ticket.ActionText
                        </a>
                    }
                </article>
            }

            <div class="av-alert av-alert--info">
                <span class="av-alert__icon">@Html.Icon("info", 20)</span>
                <div class="av-alert__body">
                    <span class="av-alert__title">@T("Bạn cần đổi lịch trình?", "Need to change your trip?")</span>
                    <span>@T("Chọn đặt chỗ và gửi yêu cầu đổi/hoàn. Bộ phận vận hành sẽ kiểm tra điều kiện vé.", "Choose a booking to request a change or refund. Our staff will review your fare conditions.")</span>
                </div>
            </div>
        </section>

        <section class="ticket-detail" aria-label="@T("Chi tiết đặt chỗ", "Booking details")">
            @if (detail.NeedsScheduleSupport)
            {
                <div class="av-alert av-alert--warning" role="status">
                    <span class="av-alert__icon">@Html.Icon("alert", 20)</span>
                    <div class="av-alert__body">
                        <span class="av-alert__title">@T("Hành trình cần xử lý do thay đổi lịch bay", "This trip requires assistance after a schedule change")</span>
                        <span>@T("PDF sẽ có lại sau khi xử lý xong các chặng bị ảnh hưởng. Liên hệ", "Your PDF will be available after all affected flights are resolved. Contact") @ViewData["SupportHotline"] @T("hoặc", "or") @ViewData["SupportEmail"] @T("để thống nhất chuyến thay thế hoặc phương án hoàn.", "to arrange a replacement flight or a refund.")</span>
                    </div>
                </div>
            }
            @foreach (var change in detail.Disruptions)
            {
                <article class="av-card">
                    <div class="av-card__body av-stack av-gap-8">
                        <h2 class="av-card__title">@change.Title</h2>
                        <p>@T("Lịch cũ", "Previous schedule") · @change.OldSchedule</p>
                        @if (change.NewSchedule is not null)
                        {
                            <p>@T("Lịch mới", "New schedule") · @change.NewSchedule</p>
                        }
                        <p class="av-caption">@(change.Result ?? T("Đang chờ xử lý", "Awaiting processing"))</p>
                        @if (change.CanAccept)
                        {
                            <form method="post" action="/ve-cua-toi/bien-dong/@change.Id/chap-nhan">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="pnr" value="@detail.Pnr" />
                                <button class="av-btn av-btn--primary" type="submit">@T("Chấp nhận lịch bay mới", "Accept new schedule")</button>
                            </form>
                        }
                    </div>
                </article>
            }
            <article class="av-card">
                <div class="av-card__body av-stack av-gap-18">
