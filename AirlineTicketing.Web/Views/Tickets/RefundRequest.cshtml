                    <span>@ViewData["SupportHotline"] · 06:00–22:00 · @ViewData["SupportEmail"]. @T($"Cung cấp mã PNR {booking.Pnr} để được kiểm tra.", $"Have booking reference {booking.Pnr} ready.")</span>
