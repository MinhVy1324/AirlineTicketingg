@model RefundRequestViewModel
@{
    ViewData["Title"] = T("Gửi yêu cầu hoàn vé", "Request a refund");
    ViewData["Nav"] = "tickets";
    var booking = Model.Booking;
    var flight = booking.Flight;
}

<div class="av-page av-container">
    <header class="booking-title">
        <h1 class="av-page-title">@T("Gửi yêu cầu hoàn vé", "Request a refund")</h1>
        <p class="av-page-subtitle">@T("Vé của tôi", "My tickets") / @booking.Pnr / @T("Hoàn vé tự nguyện · Chưa gửi yêu cầu", "Voluntary refund · Request not yet submitted")</p>
    </header>

    <div class="av-alert av-alert--info">
        <span class="av-alert__icon">@Html.Icon("info", 20)</span>
        <div class="av-alert__body">
            <span class="av-alert__title">@T("Kiểm tra điều kiện và số tiền trước khi gửi", "Check the conditions and amount before submitting")</span>
            <span>
                @T("Vé đã thanh toán, chưa sử dụng. Yêu cầu hoàn được kiểm tra trước khi duyệt; gửi yêu cầu không đồng nghĩa tiền đã hoàn.", "Your ticket is paid and unused. Refund requests are reviewed and approved before funds are returned.")
            </span>
        </div>
    </div>

    <form class="booking-layout" method="post" action="/ve-cua-toi/yeu-cau-hoan">
        @Html.AntiForgeryToken()

        <div class="booking-main">
            <section class="av-card">
                <div class="av-card__body av-stack av-gap-18">
                    <div class="av-stack av-gap-4">
                        <h2 class="av-card__title">@T("Vé đề nghị hoàn", "Tickets for refund") · @booking.Pnr</h2>
                        <span class="av-caption">@booking.Passenger.FullName · @T("Số vé", "Ticket number") @booking.TicketNumber</span>
                    </div>

                    @if (booking.Journey is { } journey) { <p>@T("Yêu cầu hoàn áp dụng cho toàn bộ hành khách và tất cả chặng trong mã đặt chỗ này.", "The refund request covers all passengers and flights under this booking reference.")</p><partial name="_JourneySummary" model="journey" /> } else { <partial name="_JourneyBlock" model="flight" /> }

                    <div class="av-rows">
                        <div class="av-rowline">
                            <span class="av-rowline__label">@T("Ghế / hành lý", "Seat and baggage")</span>
                            <span class="av-rowline__value">@Model.SeatBaggageText</span>
                        </div>
                        @if (booking.Price.ChangeFeePaid > 0)
                        {
                            <div class="av-rowline">
                                <span class="av-rowline__label">@T("Phí đổi vé đã thu", "Change fee already paid")</span>
                                <span class="av-rowline__value av-num">−@Money.Vnd(booking.Price.ChangeFeePaid)</span>
                            </div>
                        }
                        <div class="av-rowline av-rowline--total">
                            <span class="av-rowline__label">@T("Tổng đã thanh toán", "Total paid")</span>
                            <span class="av-rowline__value av-num">@Money.Vnd(booking.Price.Total)</span>
                        </div>
                    </div>
                </div>
            </section>

            <section class="av-card">
                <div class="av-card__body av-stack av-gap-16">
                    <h2 class="av-card__title">@T("Điều kiện hoàn tự nguyện", "Voluntary refund conditions")</h2>

                    <span class="av-badge av-badge--success">@T("Đủ điều kiện gửi yêu cầu", "Eligible to request a refund")</span>

                    <p class="cond-text">@Model.DeadlineText</p>
                    <p class="cond-text">
                        @T($"Phí hoàn vé: {Money.Vnd(Model.RefundFee)}/đặt chỗ trong bản demo. Không hoàn phí dịch vụ {Money.Vnd(Model.ServiceFee)} và hành lý thêm {Money.Vnd(Model.BaggageFee)}.",
                            $"The demo refund fee is {Money.Vnd(Model.RefundFee)} per booking. The service fee of {Money.Vnd(Model.ServiceFee)} and extra baggage fee of {Money.Vnd(Model.BaggageFee)} are non-refundable.")
                    </p>
                    <p class="av-caption">
                        @T("Số tiền cuối cùng được xác nhận sau khi kiểm tra điều kiện vé. Hoàn về phương thức thanh toán ban đầu.", "The final amount is confirmed after the fare conditions are reviewed. Refunds go to the original payment method.")
                    </p>
                </div>
            </section>

            <section class="av-card">
                <div class="av-card__body av-stack av-gap-16">
                    <h2 class="av-card__title">@T("Lý do và xác nhận", "Reason and confirmation")</h2>

                    <label class="av-field">
                        <span class="av-label">@T("Lý do hoàn vé", "Reason for requesting a refund") <span class="req">*</span></span>
                        <span class="av-control">
                            <select name="reason">
                                <option value="@Model.Reason" selected>@T(Model.Reason, "Personal plans changed")</option>
                                <option value="Công tác thay đổi">@T("Công tác thay đổi", "Work plans changed")</option>
                                <option value="Thay đổi hành trình">@T("Thay đổi hành trình", "Itinerary changed")</option>
                                <option value="Lý do khác">@T("Lý do khác", "Other")</option>
                            </select>
                            @Html.Icon("chevron-down", 17)
                        </span>
                    </label>

                    <label class="av-field">
                        <span class="av-label">@T("Thông tin bổ sung", "Additional information")</span>
                        <span class="av-control av-control--area">
                            <textarea name="note" rows="3">@Model.AdditionalInfo</textarea>
                        </span>
                    </label>

                    <div class="av-stack av-gap-10">
                        <label class="av-check">
                            <input type="checkbox" name="confirmFees" required />
                            <span>
                                @T($"Tôi hiểu phí hoàn {Money.Vnd(Model.RefundFee)}; phí dịch vụ {Money.Vnd(Model.ServiceFee)} và hành lý thêm {Money.Vnd(Model.BaggageFee)} không được hoàn. Số tiền dự kiến nhận lại là {Money.Vnd(Model.RefundTotal)}.",
                                    $"I understand the refund fee is {Money.Vnd(Model.RefundFee)}. The service fee of {Money.Vnd(Model.ServiceFee)} and extra baggage fee of {Money.Vnd(Model.BaggageFee)} are non-refundable. The estimated refund is {Money.Vnd(Model.RefundTotal)}.")
                            </span>
                        </label>
                        <label class="av-check">
                            <input type="checkbox" name="confirmAccount" required />
                            <span>
                                @T($"Tôi đồng ý gửi yêu cầu để kiểm tra và hoàn về {Model.RefundToText}, không nhận hoàn qua tài khoản khác.",
                                    $"I agree to submit this request for review and receive the refund to {Model.RefundToText}.")
                            </span>
                        </label>
                    </div>

                    <div class="request-actions">
                        <a class="av-link" href="/ve-cua-toi">@T("Quay lại đặt chỗ", "Back to booking")</a>
                        <button type="submit" class="av-btn av-btn--primary">@T("Gửi yêu cầu hoàn vé", "Request a refund")</button>
                    </div>
                </div>
            </section>
        </div>

        <aside class="booking-aside">
            <section class="av-card">
                <div class="av-card__body av-stack av-gap-16">
                    <h2 class="av-card__title">@T("Tính hoàn tiền dự kiến", "Estimated refund breakdown")</h2>

                    <div class="av-rows">
                        <div class="av-rowline">
                            <span class="av-rowline__label">@T("Tổng đã thanh toán", "Total paid")</span>
                            <span class="av-rowline__value av-num">@Money.Vnd(booking.Price.Total)</span>
                        </div>
                        <div class="av-rowline">
                            <span class="av-rowline__label">@T("Phí hoàn vé", "Refund fee")</span>
                            <span class="av-rowline__value av-num">−@Money.Vnd(Model.RefundFee)</span>
                        </div>
                        <div class="av-rowline">
                            <span class="av-rowline__label">@T("Phí dịch vụ không hoàn", "Non-refundable service fee")</span>
                            <span class="av-rowline__value av-num">−@Money.Vnd(Model.ServiceFee)</span>
                        </div>
                        <div class="av-rowline">
                            <span class="av-rowline__label">@T("Hành lý thêm không hoàn", "Non-refundable extra baggage")</span>
                            <span class="av-rowline__value av-num">−@Money.Vnd(Model.BaggageFee)</span>
                        </div>
                        <div class="av-rowline av-rowline--total">
                            <span class="av-rowline__label">@T("Dự kiến hoàn", "Estimated refund")</span>
                            <span class="av-rowline__value av-num">@Money.Vnd(Model.RefundTotal)</span>
                        </div>
                        <div class="av-rowline">
                            <span class="av-rowline__label">@T("Hoàn về nguồn thanh toán", "Refund destination")</span>
                            <span class="av-rowline__value">@Model.RefundToText</span>
                        </div>
                    </div>

                    <p class="av-micro">@T("7–15 ngày làm việc sau khi được duyệt; phụ thuộc ngân hàng.", "Allow 7–15 business days after approval, depending on your bank.")</p>
                </div>
            </section>

            <section class="av-card">
                <div class="av-card__body av-card__stack">
                    <h2 class="av-card__title">@T("Sau khi gửi yêu cầu", "What happens next")</h2>
                    <p class="cond-text">
                        @T("Bạn sẽ nhận mã yêu cầu để theo dõi tiếp nhận, kiểm tra, phê duyệt và hoàn tiền.", "You will receive a reference to track the request through review, approval, and refund.")
                    </p>
                    <p class="av-caption">
                        @T("Sau khi được duyệt, thời gian dự kiến nhận tiền là 7–15 ngày làm việc, tùy ngân hàng. Chỉ ghi nhận “Đã hoàn tiền” khi cổng thanh toán xác nhận hoàn tất.", "Approved refunds take an estimated 7–15 business days, depending on your bank. The status changes to Refunded once the payment provider confirms completion.")
                    </p>
                </div>
            </section>

            <div class="av-alert av-alert--info">
                <span class="av-alert__icon">@Html.Icon("headset", 20)</span>
                <div class="av-alert__body">
