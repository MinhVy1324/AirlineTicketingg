@model ScheduleChangedViewModel
@{
    ViewData["Title"] = T("Chuyến bay của bạn thay đổi giờ", "Your flight time has changed");
    ViewData["Nav"] = "tickets";
    var booking = Model.Booking;
    var flight = booking.Flight;
}

<div class="av-page av-container">
    <header class="booking-title">
        <h1 class="av-page-title">@T("Chuyến bay của bạn thay đổi giờ", "Your flight time has changed")</h1>
        <p class="av-page-subtitle">@T("Vé của tôi", "My tickets") / @booking.Pnr · @T("Thông báo từ", "Notice from") @flight.AirlineName</p>
    </header>

    <div class="av-alert av-alert--warning">
        <span class="av-alert__icon">@Html.Icon("alert", 20)</span>
        <div class="av-alert__body">
            <span class="av-alert__title">
                @T($"{flight.FlightNumber} ngày {Money.Date(flight.Departure)} khởi hành muộn hơn 1 giờ 30 phút", $"{flight.FlightNumber} on {Money.Date(flight.Departure)} departs 1 hour and 30 minutes later")
            </span>
            <span>
                @T($"{flight.AirlineName} thông báo điều chỉnh lịch khai thác lúc 14:00 ngày 10/11/2026. Vui lòng xem giờ mới và lựa chọn phương án phù hợp.", $"{flight.AirlineName} announced a schedule change at 14:00 on 10/11/2026. Review the new time and choose a suitable option.")
            </span>
        </div>
    </div>

    <div class="booking-layout">
        <div class="booking-main">
            <section class="av-card">
                <div class="av-card__body av-stack av-gap-16">
                    <h2 class="av-card__title">@T("Chi tiết vé", "Ticket details") · @booking.Pnr</h2>

                    <div class="av-rows">
                        <div class="av-rowline">
                            <span class="av-rowline__label">@T("Hành khách", "Passenger")</span>
                            <span class="av-rowline__value">@booking.Passenger.FullName</span>
                        </div>
                        <div class="av-rowline">
                            <span class="av-rowline__label">@T("Số vé", "Ticket number")</span>
                            <span class="av-rowline__value av-num">@booking.TicketNumber</span>
                        </div>
                        <div class="av-rowline">
                            <span class="av-rowline__label">@T("Chuyến bay / tuyến", "Flight and route")</span>
                            <span class="av-rowline__value">
                                @flight.FlightNumber · @flight.From.Code → @flight.To.Code · @Money.Date(flight.Departure)
                            </span>
                        </div>
                    </div>

                    <hr class="av-divider" />

                    <div class="schedule-compare">
                        <div class="schedule-compare__col">
                            <span class="schedule-compare__label">@Model.OldScheduleLabel</span>
                            <strong class="schedule-compare__time">@Model.OldScheduleText</strong>
                            <span class="av-caption">@T("Khởi hành", "Departing from") @flight.From.Code · @T("Đến", "Arriving at") @flight.To.Code</span>
                        </div>

                        <div class="schedule-compare__col schedule-compare__col--new">
                            <span class="schedule-compare__label">@Model.NewScheduleLabel</span>
                            <strong class="schedule-compare__time">@Model.NewScheduleText</strong>
                            <span class="schedule-compare__tag">@Model.DelayText</span>
                        </div>
                    </div>

                    <p class="av-caption">
                        @T($"Tất cả thời gian theo giờ Việt Nam (UTC+7). Hành trình bay thẳng, thời lượng {Money.Duration(flight.Duration)} không thay đổi.", $"All times use Vietnam time (UTC+7). Your nonstop flight duration remains {BookingUiText.Duration(flight.Duration)}.")
                    </p>

                    <hr class="av-divider" />

                    <div class="av-rows">
                        <div class="av-rowline">
                            <span class="av-rowline__label">@T("Hạng / ghế", "Cabin class and seat")</span>
                            <span class="av-rowline__value">@UiLanguage.Label(flight.FareName) · @booking.SeatCode</span>
                        </div>
                        <div class="av-rowline">
                            <span class="av-rowline__label">@T("Hành lý", "Baggage")</span>
                            <span class="av-rowline__value">@T("12 kg xách tay + 23 kg ký gửi + thêm 10 kg", "12 kg carry-on + 23 kg checked + 10 kg extra")</span>
                        </div>
                        <div class="av-rowline">
                            <span class="av-rowline__label">@T("Thanh toán", "Payment")</span>
                            <span class="av-rowline__value">@T("Đã thanh toán", "Paid") · @Money.Vnd(booking.Price.Total)</span>
                        </div>
                    </div>

                    <hr class="av-divider" />

                    <div class="av-stack av-gap-12">
                        <h3 class="av-title-20">@T("Lựa chọn của bạn", "Your options")</h3>
                        <p class="av-body">
                            @T("Chấp nhận lịch mới nếu lịch trình vẫn phù hợp. Nếu cần chuyến khác, gửi yêu cầu để AeroViet kiểm tra phương án với hãng.", "Accept the new schedule if it suits your trip. If you need another flight, send a request so AeroViet can check alternatives with the airline.")
                        </p>

                        <div class="av-row av-gap-12 av-wrap">
                            <button type="button" class="av-btn av-btn--primary">@T("Xác nhận lịch mới", "Accept new schedule")</button>
                            <a class="av-btn av-btn--outline" href="/ve-cua-toi/yeu-cau-doi">@T("Yêu cầu hỗ trợ / đổi chuyến", "Request support or a flight change")</a>
                        </div>

                        <p class="av-caption">
                            @T("Chưa xác nhận lịch mới. Việc gửi yêu cầu hỗ trợ không tự động đổi vé.", "The new schedule is awaiting your confirmation. Support requests are reviewed before your ticket changes.")
                        </p>
                    </div>
                </div>
            </section>
        </div>

        <aside class="booking-aside">
            <section class="av-card">
                <div class="av-card__body av-card__stack">
                    <h2 class="av-card__title">@T("Thông báo của hãng", "Airline notice")</h2>
                    <p class="av-body">@Model.NoticeReason</p>
                    <p class="av-caption">@Model.NoticeAppliedText</p>
                    <span class="av-badge av-badge--warning">@T("Chờ khách xác nhận", "Awaiting your confirmation")</span>
                </div>
            </section>

            <div class="av-alert av-alert--info">
                <span class="av-alert__icon">@Html.Icon("info", 20)</span>
                <div class="av-alert__body">
                    <span class="av-alert__title">@T("Thay đổi do hãng hàng không", "Airline schedule change")</span>
                    <span>
                        @T($"Không tự áp phí đổi tự nguyện {Money.Vnd(flight.ChangeFee)}. Phương án đổi miễn phí hoặc hỗ trợ khác phụ thuộc thông báo và điều kiện của hãng; AeroViet sẽ xác nhận trước khi thực hiện.", $"The voluntary change fee of {Money.Vnd(flight.ChangeFee)} does not apply automatically. AeroViet will confirm any free rebooking or other assistance based on the airline conditions.")
                    </span>
                </div>
            </div>

