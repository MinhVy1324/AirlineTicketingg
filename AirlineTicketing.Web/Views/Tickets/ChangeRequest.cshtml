        <div class="booking-main">
            <section class="av-card">
                <div class="av-card__body av-stack av-gap-16">
                    <div class="av-stack av-gap-4">
                        <h2 class="av-card__title">@T("Vé hiện tại", "Current ticket") · @booking.Pnr</h2>
                        <span class="av-caption">@booking.Passenger.FullName · @T("Số vé", "Ticket number") @booking.TicketNumber</span>
                    </div>

                    <partial name="_JourneyBlock" model="current" />

                    <hr class="av-divider" />

                    <div class="av-rowline">
                        <span class="av-rowline__label">@T("Ghế / hành lý", "Seat and baggage")</span>
                        <span class="av-rowline__value">@Model.SeatBaggageText</span>
                    </div>
                </div>
            </section>

            <section class="av-card">
                <div class="av-card__body av-stack av-gap-16">
                    <h2 class="av-card__title">@T("Chọn chuyến mới", "Choose a new flight")</h2>

                    @if (next is null)
                    {
                        <p class="av-body">@T("Hiện chưa có chuyến thay thế cùng tuyến trong thời gian mở bán.", "No alternative flights on this route are currently available.")</p>
                    }
                    else
                    {
                        <nav class="av-chips" aria-label="@T("Chuyến thay thế cùng tuyến", "Alternative flights for the same route")">
                            @foreach (var flight in Model.Candidates)
                            {
                                <a class="av-chip @(next.Id == flight.Id ? "is-active" : null)"
                                   aria-current="@(next.Id == flight.Id ? "true" : null)"
                                   href="/ve-cua-toi/yeu-cau-doi?pnr=@booking.Pnr&amp;newFlightId=@flight.Id">
                                    @flight.FlightNumber · @Money.Date(flight.Departure) @Money.Time(flight.Departure)
                                </a>
                            }
                        </nav>
                        <div class="request-flight">
                            <partial name="_JourneyBlock" model="next" />
                            <p class="av-caption">@T("Giá và chỗ là dự kiến. Hệ thống cấp ghế tiêu chuẩn khi bạn xác nhận báo giá đã duyệt.", "The fare and availability are estimates. A standard seat will be assigned after you confirm the approved quote.")</p>
                        </div>
                    }
                </div>
            </section>

            @if (next is not null)
            {
            <section class="av-card">
                <div class="av-card__body av-stack av-gap-16">
                    <h2 class="av-card__title">@T("So sánh vé cũ và vé mới", "Compare your current and new tickets")</h2>

                    <div class="av-rows">
                        <div class="av-rowline">
                            <span class="av-rowline__label">@T("Giá vé cơ bản hiện tại", "Current base fare")</span>
                            <span class="av-rowline__value">@Money.Vnd(Model.CurrentFare)</span>
                        </div>
                        <div class="av-rowline">
                            <span class="av-rowline__label">@T("Giá vé cơ bản chuyến mới", "New base fare")</span>
                            <span class="av-rowline__value">@Money.Vnd(Model.NewBaseFare)</span>
                        </div>
                    </div>
                    <p class="av-caption">@T("Nếu chuyến mới có giá thấp hơn, chênh lệch không được hoàn.", "A lower fare on the new flight does not qualify for a refund of the difference.")</p>

                    <div class="request-diff">
                        <span class="av-muted">@T("Chênh lệch giá", "Fare difference")</span>
                        <strong>@Money.Vnd(Model.PriceDifference)</strong>
                    </div>
                </div>
            </section>

            <section class="av-card">
                <div class="av-card__body av-stack av-gap-16">
                    <h2 class="av-card__title">@T("Xác nhận trước khi gửi", "Confirm before sending")</h2>

                    <label class="av-field">
                        <span class="av-label">@T("Lý do đổi vé", "Reason for changing your ticket") <span class="req">*</span></span>
                        <span class="av-control">
                            <select name="reason">
                                <option value="@Model.Reason" selected>@T(Model.Reason, "Personal plans changed")</option>
                                <option value="Công tác thay đổi">@T("Công tác thay đổi", "Work plans changed")</option>
                                <option value="Thay đổi hành trình">@T("Thay đổi hành trình", "Itinerary changed")</option>
                                <option value="Lý do khác">@T("Lý do khác", "Other")</option>
                            </select>
                            @Html.Icon("chevron-down", 17)
                        </span>
                    </label>

                    <label class="av-check">
                        <input type="checkbox" name="confirm" required />
                        <span>
                            @T($"Tôi đã đọc điều kiện đổi, đồng ý phí đổi {Money.Vnd(Model.ChangeFee)} và chênh lệch dự kiến {Money.Vnd(Model.PriceDifference)}. Tôi sẽ xác nhận mức phí cuối cùng trước khi thanh toán thêm.",
                                $"I have read the change conditions and accept the change fee of {Money.Vnd(Model.ChangeFee)} and an estimated fare difference of {Money.Vnd(Model.PriceDifference)}. I will confirm the final charge before payment.")
                        </span>
                    </label>

                    <div class="request-actions">
                        <a class="av-link" href="/ve-cua-toi">@T("Quay lại đặt chỗ", "Back to booking")</a>
                        <button type="submit" class="av-btn av-btn--primary">@T("Gửi yêu cầu đổi vé", "Request a ticket change")</button>
                    </div>

                    <p class="av-micro">
                        @T("Thao tác này chỉ gửi yêu cầu, chưa đổi xong và chưa xuất lại vé. Vé cũ chưa được thay thế tại bước này.", "This sends the change request for review. Your current ticket remains valid at this stage.")
                    </p>
                </div>
            </section>
            }
        </div>

        <aside class="booking-aside">
            @if (next is not null)
            {
            <section class="av-card">
                <div class="av-card__body av-stack av-gap-16">
                    <h2 class="av-card__title">@T("Thanh toán thêm dự kiến", "Estimated additional payment")</h2>

                    <div class="av-rows">
                        <div class="av-rowline">
                            <span class="av-rowline__label">@T("Chênh lệch giá vé", "Fare difference")</span>
                            <span class="av-rowline__value av-num">@Money.Vnd(Model.PriceDifference)</span>
                        </div>
                        <div class="av-rowline">
                            <span class="av-rowline__label">@T("Phí đổi vé", "Change fee")</span>
                            <span class="av-rowline__value av-num">@Money.Vnd(Model.ChangeFee)</span>
                        </div>
                        <div class="av-rowline av-rowline--total">
                            <span class="av-rowline__label">@T("Tổng cần thanh toán thêm", "Total additional payment")</span>
                            <span class="av-rowline__value av-num">@Money.Vnd(Model.TotalExtra)</span>
                        </div>
                    </div>

                    <p class="av-caption">
                        @T("Chưa thu tiền tại bước gửi yêu cầu. Chỉ thanh toán sau khi còn chỗ và được xác nhận mức phí cuối cùng.", "Payment is due after availability and the final charge are confirmed.")
                    </p>
                </div>
            </section>

            }
            <section class="av-card">
                <div class="av-card__body av-card__stack">
                    <h2 class="av-card__title">@T("Điều kiện đổi / hoàn tự nguyện", "Voluntary changes and refunds")</h2>
                    <p class="cond-text">
                        @T($"Gửi trước giờ bay ít nhất 3 tiếng. Đổi: {Money.Vnd(Model.ChangeFee)} + chênh lệch giá. Hoàn: phí {Money.Vnd(current.RefundFee)}.",
                            $"Submit your request at least 3 hours before departure. The change fee is {Money.Vnd(Model.ChangeFee)} plus any fare difference. The refund fee is {Money.Vnd(current.RefundFee)}.")
                    </p>
                    <p class="av-caption">
                        @T($"Phí dịch vụ {Money.Vnd(booking.Price.ServiceFee)} và hành lý mua thêm {Money.Vnd(booking.Price.BaggageFee)} không hoàn. Không đổi/hoàn khi không có mặt. Số tiền cuối cùng được xác nhận khi xử lý.",
                            $"The service fee of {Money.Vnd(booking.Price.ServiceFee)} and extra baggage fee of {Money.Vnd(booking.Price.BaggageFee)} are non-refundable. Changes and refunds are unavailable after a no-show. The final amount is confirmed during processing.")
                    </p>
                </div>
            </section>

            <section class="av-card">
                <div class="av-card__body av-card__stack">
                    <h2 class="av-card__title">@T("Quy trình xử lý", "What happens next")</h2>
                    <ol class="request-steps">
                        <li>@T("Tiếp nhận và kiểm tra chỗ", "Review your request and check availability")</li>
                        <li>@T("Gửi mức phí để bạn xác nhận", "Send you a quote to confirm")</li>
                        <li>@T("Xác nhận khoản thanh toán mô phỏng", "Confirm the simulated payment")</li>
                        <li>@T("Xuất lại vé và gửi qua email", "Reissue your ticket and send it by email")</li>
                    </ol>
                </div>
            </section>

            <div class="av-alert av-alert--info">
                <span class="av-alert__icon">@Html.Icon("headset", 20)</span>
                <div class="av-alert__body">
