@model ChangeRequestViewModel
@{
    ViewData["Title"] = T("Gửi yêu cầu đổi vé", "Request a ticket change");
    ViewData["Nav"] = "tickets";
    var booking = Model.Booking;
    var current = booking.Flight;
    var next = Model.NewFlight;
}

<div class="av-page av-container">
    <header class="booking-title">
        <h1 class="av-page-title">@T("Gửi yêu cầu đổi vé", "Request a ticket change")</h1>
        <p class="av-page-subtitle">@T("Vé của tôi", "My tickets") / @booking.Pnr / @T("Đổi vé tự nguyện · Chưa gửi yêu cầu", "Voluntary change · Request not yet submitted")</p>
    </header>

    <form class="booking-layout" method="post" action="/ve-cua-toi/yeu-cau-doi">
        @Html.AntiForgeryToken()
