                                    @Html.Icon("chevron-right", 15)
                                </a>
                            }
                        </div>
                    </header>

                    <div class="price-week__chart">
                        @foreach (var day in Model.DayPrices)
                        {
                            var height = 0;
                            if (day.HasPrice && maxPrice > 0)
                            {
                                height = maxPrice == minPrice
                                    ? 70
                                    : 28 + (int)Math.Round((double)((day.Price - minPrice) / (maxPrice - minPrice)) * 72);
                            }

                            var isCheapest = day.HasPrice && day.Price == minPrice;
                            var css = "price-day"
                                + (day.IsActive ? " is-active" : string.Empty)
                                + (isCheapest ? " is-cheapest" : string.Empty)
                                + (day.HasPrice ? string.Empty : " is-empty");

                            <a class="@css"
                               href="@Model.SearchUrl(day.Date)"
                               aria-current="@(day.IsActive ? "true" : null)"
                               title="@(day.HasPrice ? T($"Xem chuyến ngày {day.DateText} · từ {Money.Vnd(day.Price)}", $"View flights on {day.DateText} · from {Money.Vnd(day.Price)}") : T($"Chưa có chuyến ngày {day.DateText}", $"No flights on {day.DateText}"))">
                                <span class="price-day__tag @(isCheapest && !day.IsActive ? null : "price-day__tag--ghost")">
