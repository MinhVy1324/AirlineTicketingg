<div class="av-page av-container">
    @if (criteria.TripTypeText == "Khứ hồi")
    {
        <div class="av-alert av-alert--info"><div class="av-alert__body">
            <strong>@(criteria.SelectingReturn ? T("Bước 2/2 · Chọn chiều về", "Step 2 of 2 · Select return flight") : T("Bước 1/2 · Chọn chiều đi", "Step 1 of 2 · Select outbound flight"))</strong>
            <span>@T($"Đi {criteria.OutboundDateText} · Về {criteria.ReturnDateText}", $"Outbound {criteria.OutboundDateText} · Return {criteria.ReturnDateText}") · @BookingUiText.Party(criteria.EffectiveParty) · @BookingUiText.Text(criteria.Cabin)</span>
            @if (Model.SelectedOutbound is { } selected)
            {
                <span>@T("Chiều đi đã chọn:", "Selected outbound flight:") @selected.FlightNumber · @selected.From.Code → @selected.To.Code · @Money.Time(selected.Departure)</span>
                <a href="@FlightSearchUrl.Build(new FlightResultsViewModel { Criteria = criteria with { SelectedOutboundId = null, OriginCode = criteria.JourneyOriginCode!, DestinationCode = criteria.JourneyDestinationCode!, DepartDateText = criteria.OutboundDateText! }, Filters = Model.Filters, SortKey = Model.SortKey })">@T("Chọn lại chiều đi", "Change outbound flight")</a>
            }
            <span>@T("Chỗ được giữ sau khi xác nhận thông tin hành khách cho toàn bộ hành trình.", "Seats are held once you confirm the passenger details for the entire trip.")</span>
        </div></div>
    }
    @if (Model.IsEmpty)
    {
        <div class="av-stack av-gap-6">
            <h1 class="av-page-title">@T("Kết quả tìm chuyến", "Flight search results")</h1>
            <p class="av-page-subtitle">
                @criteria.RouteText · @BookingUiText.SearchSummary(criteria)
            </p>
        </div>
