    <section class="search-summary" aria-label="@T("Tìm kiếm hiện tại", "Current search")">
        <div class="search-summary__route">
            @Html.Icon("plane-takeoff", 20)
            <div class="av-stack av-gap-6">
                <h2 class="search-summary__title">@criteria.RouteText</h2>
                <p class="search-summary__sub">
                    @if (Model.IsEmpty)
                    {
                        <text>@criteria.DepartDateText · @BookingUiText.Party(criteria.EffectiveParty) · @BookingUiText.Text(criteria.Cabin)</text>
                    }
                    else
                    {
                        <text>@BookingUiText.SearchSummary(criteria)</text>
                    }
                </p>
            </div>
        </div>
        <a class="av-btn av-btn--outline" href="@Model.SearchUrl(clearFilters: true).Replace("/chuyen-bay?", "/?")">
            @Html.Icon("sliders", 17)
            <span>@T("Chỉnh sửa tìm kiếm", "Edit search")</span>
        </a>
    </section>

