@model FlightResultsViewModel
@{
    ViewData["Title"] = "Kết quả tìm chuyến";
    ViewData["Nav"] = "book";
    var criteria = Model.Criteria;
    var pricedDays = Model.DayPrices.Where(d => d.HasPrice).ToList();
    var minPrice = pricedDays.Count > 0 ? pricedDays.Min(d => d.Price) : 0m;
    var maxPrice = pricedDays.Count > 0 ? pricedDays.Max(d => d.Price) : 0m;
    var tripParam = criteria.TripTypeText == "Khứ hồi" ? "roundtrip" : "oneway";
}

<div class="av-page av-container">
    @if (Model.IsEmpty)
    {
        <div class="av-stack av-gap-6">
            <h1 class="av-page-title">Kết quả tìm chuyến</h1>
            <p class="av-page-subtitle">
                @criteria.RouteText · @criteria.SummaryText
            </p>
        </div>
    }

    <section class="search-summary" aria-label="Tìm kiếm hiện tại">
        <div class="search-summary__route">
            @Html.Icon("plane-takeoff", 20)
            <div class="av-stack av-gap-6">
                <h2 class="search-summary__title">@criteria.RouteText</h2>
                <p class="search-summary__sub">
                    @if (Model.IsEmpty)
                    {
                        <text>@criteria.DepartDateText · @criteria.Passengers người lớn · @criteria.Cabin</text>
                    }
                    else
                    {
                        <text>@criteria.SummaryText</text>
                    }
                </p>
            </div>
        </div>
        <a class="av-btn av-btn--outline" href="/">
            @Html.Icon("sliders", 17)
            <span>Chỉnh sửa tìm kiếm</span>
        </a>
    </section>

    <div class="results-layout">
        <partial name="_FilterPanel" model="Model" />

        <section class="results-main">
            <div class="results-head">
                <h2 class="results-head__count">
                    @(Model.IsEmpty ? 0 : (Model.TotalCount > 0 ? Model.TotalCount : Model.ResultCount)) chuyến phù hợp
                </h2>

                <form class="sort-form" method="get" action="/chuyen-bay" data-sort-form>
                    <input type="hidden" name="from" value="@criteria.OriginCode" />
                    <input type="hidden" name="to" value="@criteria.DestinationCode" />
                    <input type="hidden" name="depart" value="@criteria.DepartDateText" />
                    <input type="hidden" name="passengers" value="@criteria.Passengers" />
                    <input type="hidden" name="cabin" value="@criteria.Cabin" />
                    <input type="hidden" name="trip" value="@tripParam" />
                    <label class="sort-form__label" for="sort-select">Sắp xếp</label>
                    <span class="sort-form__control">
                        <select class="sort-form__select" id="sort-select" name="sort" data-sort-select>
                            @foreach (var option in Model.SortOptions)
                            {
                                <option value="@option.Key" selected="@(option.Key == Model.SortKey)">@option.Label</option>
                            }
                        </select>
                        @Html.Icon("chevron-down", 14)
                    </span>
                    <noscript>
                        <button type="submit" class="av-btn av-btn--outline">Áp dụng</button>
                    </noscript>
                </form>
            </div>

            @if (Model.DayPrices.Count > 0)
            {
                <section class="price-week" aria-labelledby="price-week-title">
                    <header class="price-week__head">
                        <div class="price-week__heading">
                            <h3 class="price-week__title" id="price-week-title">Giá theo ngày</h3>
                            <span class="price-week__range">Tuần @Model.WeekRangeText</span>
                        </div>

                        <div class="price-week__nav">
                            @if (Model.PreviousWeek is { } previousWeek)
                            {
                                <a class="price-week__arrow"
                                   asp-controller="Flights" asp-action="Index"
                                   asp-route-from="@criteria.OriginCode"
                                   asp-route-to="@criteria.DestinationCode"
                                   asp-route-depart="@FlightMapping.DisplayDate(previousWeek)"
                                   asp-route-passengers="@criteria.Passengers"
                                   asp-route-cabin="@criteria.Cabin"
                                   asp-route-trip="@tripParam"
                                   asp-route-sort="@Model.SortKey"
                                   aria-label="Xem tuần trước">
                                    @Html.Icon("chevron-left", 15)
                                </a>
                            }
                            @if (Model.NextWeek is { } nextWeek)
                            {
                                <a class="price-week__arrow"
                                   asp-controller="Flights" asp-action="Index"
                                   asp-route-from="@criteria.OriginCode"
                                   asp-route-to="@criteria.DestinationCode"
                                   asp-route-depart="@FlightMapping.DisplayDate(nextWeek)"
                                   asp-route-passengers="@criteria.Passengers"
                                   asp-route-cabin="@criteria.Cabin"
                                   asp-route-trip="@tripParam"
                                   asp-route-sort="@Model.SortKey"
                                   aria-label="Xem tuần sau">
                                    @Html.Icon("chevron-right", 15)
                                </a>
                            }
                        </div>
                    </header>

                    <div class="price-week__chart">
                        @foreach (var day in Model.DayPrices)
                        {
                            var height = 0;
                            if (day.HasPrice && maxPrice > 0)
                            {
                                height = maxPrice == minPrice
                                    ? 70
                                    : 28 + (int)Math.Round((double)((day.Price - minPrice) / (maxPrice - minPrice)) * 72);
                            }

                            var isCheapest = day.HasPrice && day.Price == minPrice;
                            var css = "price-day"
                                + (day.IsActive ? " is-active" : string.Empty)
                                + (isCheapest ? " is-cheapest" : string.Empty)
                                + (day.HasPrice ? string.Empty : " is-empty");

                            <a class="@css"
                               asp-controller="Flights" asp-action="Index"
                               asp-route-from="@criteria.OriginCode"
                               asp-route-to="@criteria.DestinationCode"
                               asp-route-depart="@FlightMapping.DisplayDate(day.Date)"
                               asp-route-passengers="@criteria.Passengers"
                               asp-route-cabin="@criteria.Cabin"
                               asp-route-trip="@tripParam"
                               asp-route-sort="@Model.SortKey"
                               aria-current="@(day.IsActive ? "true" : null)"
                               title="@(day.HasPrice ? $"Xem chuyến ngày {day.DateText} · từ {Money.Vnd(day.Price)}" : $"Chưa có chuyến ngày {day.DateText}")">
                                <span class="price-day__tag @(isCheapest && !day.IsActive ? null : "price-day__tag--ghost")">
                                    Rẻ nhất
                                </span>
                                <span class="price-day__price">@(day.HasPrice ? Money.Vnd(day.Price) : "—")</span>
                                <span class="price-day__track">
                                    @if (day.HasPrice)
                                    {
                                        <span class="price-day__bar" style="height:@(height)%"></span>
                                    }
                                </span>
                                <span class="price-day__date">
                                    <strong>@day.WeekdayText</strong>
                                    <span>@day.DateText</span>
                                </span>
                            </a>
                        }
                    </div>

                    <p class="price-week__hint">
                        Giá thấp nhất mỗi ngày trong tuần · chọn một ngày để xem chuyến.
                    </p>
                </section>
            }

            @if (Model.IsEmpty)
            {
                <div class="av-card results-empty">
                    <div class="av-empty">
                        <span class="av-empty__icon">@Html.Icon("search", 26)</span>
                        <h3 class="av-empty__title">@Model.EmptyTitle</h3>
                        <p class="av-empty__text">@Model.EmptyText</p>
                        <div class="results-empty__actions">
                            <a class="av-btn av-btn--primary" href="/chuyen-bay">Bỏ tất cả bộ lọc</a>
                            <a class="av-btn av-btn--outline" href="/">Đổi ngày bay</a>
                        </div>
                    </div>
                </div>

                <div class="av-alert av-alert--info">
                    <span class="av-alert__icon">@Html.Icon("info", 20)</span>
                    <div class="av-alert__body">
                        <span class="av-alert__title">Vẫn muốn bay ngày @criteria.DepartDateText?</span>
                        <span>
                            Bỏ bộ lọc để xem các chuyến khác trên tuyến @criteria.OriginCode → @criteria.DestinationCode.
                            Giá hiển thị theo từng ngày đã gồm thuế, phí; cần kiểm tra lại chỗ khi chọn.
                        </span>
                    </div>
                </div>
            }
            else
            {
                @for (var i = 0; i < Model.Flights.Count; i++)
                {
                    <div class="flight-list__item @(i >= 3 ? "is-hidden" : null)" data-flight-item>
                        <partial name="_FlightCard" model="Model.Flights[i]" />
                    </div>
                }

                @if (Model.Flights.Count > 3)
                {
                    <div class="results-more">
                        <button type="button" class="av-btn av-btn--outline"
                                data-show-more data-step="3"
                                data-total="@Model.Flights.Count">
                            @Html.Icon("chevron-down", 17)
                            <span data-show-more-label>Xem thêm @Math.Min(3, Model.Flights.Count - 3) chuyến</span>
                        </button>
                    </div>
                }
            }
        </section>
    </div>
</div>
