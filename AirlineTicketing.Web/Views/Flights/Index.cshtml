                                <span class="price-day__price">@(day.HasPrice ? Money.Vnd(day.Price) : "—")</span>
                                <span class="price-day__track">
                                    @if (day.HasPrice)
                                    {
                                        <span class="price-day__bar" style="height:@(height)%"></span>
                                    }
                                </span>
                                <span class="price-day__date">
                                    <strong>@(UiLanguage.IsEnglish ? day.Date.ToString("ddd", System.Globalization.CultureInfo.GetCultureInfo("en")) : day.WeekdayText)</strong>
                                    <span>@day.DateText</span>
                                </span>
                            </a>
                        }
