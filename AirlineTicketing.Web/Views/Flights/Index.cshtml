                            <span class="price-week__range">@T("Tuần", "Week") @Model.WeekRangeText</span>
                        </div>

                        <div class="price-week__nav">
                            @if (Model.PreviousWeek is { } previousWeek)
                            {
                                <a class="price-week__arrow"
                                   href="@Model.SearchUrl(previousWeek)"
                                   aria-label="@T("Xem tuần trước", "View previous week")">
                                    @Html.Icon("chevron-left", 15)
                                </a>
                            }
                            @if (Model.NextWeek is { } nextWeek)
                            {
                                <a class="price-week__arrow"
                                   href="@Model.SearchUrl(nextWeek)"
