{
  "Booking": {
    "HoldMinutes": 15,
    // Chu kỳ quét đặt chỗ quá hạn giữ (giây), do HoldExpiryService chạy nền.
    "ExpirySweepSeconds": 60
  },
  "Auth": {
    // SameAsRequest phù hợp khi chạy Docker trên HTTP nội bộ; đặt "Always"
    // khi triển khai thật sau HTTPS để cookie không bao giờ đi qua kết nối thường.
    "CookieSecurePolicy": "SameAsRequest",
    "LoginPermitLimit": 5,
    "LoginWindowSeconds": 60
  },
  // Không đặt connection string trong file này. Cấu hình qua biến môi trường
  // ConnectionStrings__DefaultConnection hoặc các biến POSTGRES_* trong .env
  // (xem docs/INSTALL.md và docs/DOCKER-SETUP.md).
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
